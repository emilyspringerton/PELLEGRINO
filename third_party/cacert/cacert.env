# The trust store PELLEGRINO ships as cacert.pem (the ONLY store https:// has on Windows; the fallback on
# Linux). A dated, sha256-pinned snapshot of Mozilla's root list as extracted by curl.se -- never the build
# host's own store (which can carry a corporate proxy root or a developer's local CA).
# Bump all three together, deliberately: `curl -fsSL $CACERT_URL.sha256` publishes the digest; the file's own
# header names the Mozilla revision. scripts/fetch_cacert.sh verifies the digest and then parses the file.
CACERT_DATE=2026-09-25
CACERT_URL=https://curl.se/ca/cacert-2026-09-25.pem
CACERT_SHA256=a41b5d356aea97a529fe27e0f7316d2f9d946d75927476cf9cf1b90637d00505
