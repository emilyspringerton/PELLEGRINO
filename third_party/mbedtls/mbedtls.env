# Single source of truth for the pinned mbedTLS release. MODULE.bazel repeats URL + sha256 (Bazel cannot
# read this file); tests/check_pins.sh fails if the two ever disagree.
# 3.6 is the supported LTS branch; the sha256 matches the digest GitHub publishes for the release asset.
MBEDTLS_VERSION=3.6.7
MBEDTLS_URL=https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-3.6.7/mbedtls-3.6.7.tar.bz2
MBEDTLS_SHA256=a7e8bcbec0e6f761b4af24f25677626b35f762f68eef79c08677a363212d11f6
