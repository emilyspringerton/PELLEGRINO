load("@parena//bazel:parena_compile.bzl", "parena_compile_c")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# pellegrino.prn (+ the PARENA stdlib it stands on) -> C. Output is a .inc so the host can #include it
# as a single translation unit instead of Bazel compiling it as a second, symbol-duplicating .c file.
parena_compile_c(
    name = "pellegrino_gen",
    prn = "pellegrino.prn",
    out = "pellegrino_gen.inc",
    deps = [
        "@parena//stdlib:string.prn",
        "@parena//stdlib:array.prn",
        "@parena//stdlib:io.prn",
        "@parena//stdlib:sdl2.prn",
        "@parena//stdlib:net/stream.prn",
    ],
)

# The slim C host: main() + log redirection. Everything else is the generated PARENA.
cc_binary(
    name = "pellegrino",
    srcs = [
        "pellegrino_host.c",
        ":pellegrino_gen",
    ],
    linkopts = [
        "-lSDL2",
        "-lm",
    ],
    # HTTPS: the PARENA runtime's TLS half of net/stream, over mbedTLS from third_party/ (static heap, so
    # still no malloc; the user config in third_party/mbedtls turns on the buffer allocator).
    copts = [
        "-DPARENA_WITH_TLS",
        "-DPARENA_TLS_STATIC_HEAP",
        "-DPARENA_TLS_HEAP_STATS",
    ],
    deps = [
        "@mbedtls",
        "@parena//runtime:parena_runtime",
    ],
)

# Headless smoke tests: open the borderless window under Xvfb, stream the embedded page, a live HTTP
# page, redirects and live HTTPS (trusted, untrusted and wrong-host certificates) from local servers,
# exit cleanly, and check the real text log file the run wrote.
sh_test(
    name = "smoke",
    srcs = ["tests/smoke.sh"],
    data = [
        ":pellegrino",
        "tests/smoke_server.py",
    ],
    tags = [
        "local",
        "requires-openssl",
        "requires-xvfb",
    ],
)

# The mbedTLS pin is spelled in MODULE.bazel and third_party/mbedtls/mbedtls.env; they must agree.
sh_test(
    name = "check_pins",
    srcs = ["tests/check_pins.sh"],
    data = [
        "MODULE.bazel",
        "//third_party/mbedtls:mbedtls.env",
    ],
)
