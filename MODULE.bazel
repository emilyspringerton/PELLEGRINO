"""PELLEGRINO -- streaming text renderer / terminal shell, pure PARENA + a slim C host (Bazel)."""

module(
    name = "pellegrino",
    version = "0.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "parena", version = "0.0.0")

# PARENA is pinned by commit (bump deliberately). Local development against a sibling checkout:
#   bazelisk build //:pellegrino --override_module=parena=../PARENA
git_override(
    module_name = "parena",
    remote = "https://github.com/emilyspringerton/PARENA.git",
    commit = "575bdf5f1cc79de5239240df6a27893ae7b95353",
)

# mbedTLS (TLS client for https://), built from source so it can allocate from a static buffer (NO MALLOC).
# Pin: third_party/mbedtls/mbedtls.env is the readable copy; tests/check_pins.sh keeps the two equal.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "mbedtls",
    build_file = "//third_party/mbedtls:mbedtls.BUILD",
    sha256 = "a7e8bcbec0e6f761b4af24f25677626b35f762f68eef79c08677a363212d11f6",
    strip_prefix = "mbedtls-3.6.7",
    urls = ["https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-3.6.7/mbedtls-3.6.7.tar.bz2"],
)
