        ls (if (>= gt 0) (+ gt 1) 0)
        le2 (if (>= gt 0) (opt-label-end page ls lim) 0)
        sc (tget 3)
        cw (* 6 sc)
        n (if (> le2 ls) (- le2 ls) 0)
        w (* (+ n 4) cw)
