;; color of the token page[s0,e0): #hex rgb() hsl() a name, currentcolor; -1 when it is none of those (or transparent)
(defn parse-color [(page : String @ Region) (s0 : I32) (e0 : I32)] : I32
  (let [s (skip-ws page s0 e0)
        e (trim-end page s e0)]
    (cond
      ((>= s e) -1)
      ((= (string/char-at page s) 35) (hex-col page (+ s 1) e))
      ((= (has-at page s e "rgb") 1) (rgb-col page s e))
      ((= (has-at page s e "hsl") 1) (hsl-col page s e))
      ((= (word-eq page s e "transparent") 1) -1)
      ((= (word-eq page s e "currentcolor") 1) (tget 1))
      (true (name-col page s e)))))

;; end of a colour token: whitespace or ',' at paren depth 0
(defn ctok-end [(page : String @ Region) (a : I32) (e : I32)] : I32
  (loop [k a depth 0]
    (if (>= k e)
      e
      (let [c (string/char-at page k)]
        (cond
          ((= c 40) (recur (+ k 1) (+ depth 1)))
          ((= c 41) (recur (+ k 1) (if (> depth 0) (- depth 1) 0)))
          ((and (= depth 0) (or (ws? c) (= c 44))) k)
          (true (recur (+ k 1) depth)))))))

(defn skip-wsc [(page : String @ Region) (i : I32) (e : I32)] : I32
  (loop [k i]
    (if (>= k e)
      e
      (let [c (string/char-at page k)]
        (if (or (ws? c) (= c 44)) (recur (+ k 1)) k)))))

;; where to look next when the token page[a,b) was not a colour: inside a non-colour function (gradients), else past it
(defn color-next [(page : String @ Region) (a : I32) (b : I32)] : I32
  (let [o (find-in page 40 a b)]
    (if (and (>= o 0) (and (= (has-at page a b "rgb") 0) (= (has-at page a b "hsl") 0)))
      (+ o 1)
      (if (> b a) b (+ a 1)))))

;; first token of page[vs,ve) that is a colour (for `background: url(..) no-repeat #fff`, `border: 1px solid red`,
;; and gradients, whose first stop is taken)
(defn first-color [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (loop [k vs]
    (let [a (skip-wsc page k ve)]
      (if (>= a ve)
        -1
        (let [b (ctok-end page a ve)
              c (parse-color page a b)]
          (if (>= c 0) c (recur (color-next page a b))))))))

;; ---- lengths (CSS3 units, calc()) ----
(defn frac2 [(page : String @ Region) (p : I32) (e : I32)] : I32
  (+ (* (frac-digit page p e) 10) (frac-digit page (+ p 1) e)))

;; value * 100 of the number at s (digits, optional fraction; capped at 10000); the index past it lands in slot 601
(defn css-num100 [(page : String @ Region) (s : I32) (e : I32)] : I32
  (let [ip0 (if (= (string/char-at page s) 46) (ret-pos s 0) (scan-int page s e))
        ip (if (> ip0 10000) 10000 ip0)
        p (slot-get 601)
        hasf (if (and (< p e) (= (string/char-at page p) 46)) 1 0)
        f (if (= hasf 1) (frac2 page (+ p 1) e) 0)
        q (if (= hasf 1) (skip-digits page (+ p 1) e) p)]
    (ret-pos q (+ (* ip 100) f))))

(defn vmin-px [] : I32
  (if (< (slot-get 1646) (slot-get 1647)) (slot-get 1646) (slot-get 1647)))

(defn vmax-px [] : I32
  (if (> (slot-get 1646) (slot-get 1647)) (slot-get 1646) (slot-get 1647)))

;; v = value * 100 in the unit at page[u,e) -> px * 100. % is of slot 1634 (16 px unless a width is being resolved)
(defn unit-px100 [(page : String @ Region) (u : I32) (e : I32) (v : I32)] : I32
  (cond
    ((= (has-at page u e "rem") 1) (* v 16))
    ((= (has-at page u e "em") 1) (* v 16))
    ((= (has-at page u e "px") 1) v)
    ((= (has-at page u e "%") 1) (/ (* v (slot-get 1634)) 100))
    ((= (has-at page u e "pt") 1) (/ (* v 4) 3))
    ((= (has-at page u e "pc") 1) (* v 16))
    ((= (has-at page u e "vmin") 1) (/ (* v (vmin-px)) 100))
    ((= (has-at page u e "vmax") 1) (/ (* v (vmax-px)) 100))
    ((= (has-at page u e "vw") 1) (/ (* v (slot-get 1646)) 100))
    ((= (has-at page u e "vh") 1) (/ (* v (slot-get 1647)) 100))
    ((= (has-at page u e "ch") 1) (* v 12))
    ((= (has-at page u e "ex") 1) (* v 9))
    ((= (has-at page u e "cm") 1) (/ (* v 378) 10))
    ((= (has-at page u e "mm") 1) (/ (* v 378) 100))
    ((= (has-at page u e "in") 1) (* v 96))
    (true v)))

;; "12px" "1.5em" "50%" "2vw" "2" -> px (rem/em 16 px, % of 16 px); only for tokens that start with a digit
(defn len-num [(page : String @ Region) (s : I32) (e : I32)] : I32
  (let [v (css-num100 page s e)
        u (slot-get 601)]
    (/ (unit-px100 page u e v) 100)))

(defn unit-end [(page : String @ Region) (u : I32) (e : I32)] : I32
  (loop [k u]
    (if (and (< k e) (or (letter? (string/char-at page k)) (= (string/char-at page k) 37)))
      (recur (+ k 1))
      k)))

(defn calc-number [(page : String @ Region)] : I32
  (let [e (slot-get 1632)
        p (skip-ws page (slot-get 1633) e)
        c (string/char-at page p)
        st (if (or (= c 45) (= c 43)) (+ p 1) p)
        v (css-num100 page st e)
        u (slot-get 601)
        px (unit-px100 page u e v)
        sv (slot-set 1633 (unit-end page u e))]
    (if (= c 45) (- 0 px) px)))

(defn calc-factor [(page : String @ Region)] : I32
  (let [p (skip-ws page (slot-get 1633) (slot-get 1632))
        c (string/char-at page p)]
    (cond
      ((= c 40) (calc-group page (+ p 1)))
      ((= (has-at page p (slot-get 1632) "calc(") 1) (calc-group page (+ p 5)))
      (true (calc-number page)))))

(defn calc-group [(page : String @ Region) (after : I32)] : I32
  (let [sv (slot-set 1633 after)
        v (calc-sum page)
        p (skip-ws page (slot-get 1633) (slot-get 1632))
        sc (if (= (string/char-at page p) 41) (slot-set 1633 (+ p 1)) 0)]
    v))

(defn calc-mul [(a : I32) (b : I32)] : I32
  (/ (* a b) 100))

(defn calc-div [(a : I32) (b : I32)] : I32
  (if (= b 0) 0 (/ (* a 100) b)))

(defn calc-prod [(page : String @ Region)] : I32
  (calc-prod-rest page (calc-factor page)))

(defn calc-prod-rest [(page : String @ Region) (acc : I32)] : I32
  (let [p (skip-ws page (slot-get 1633) (slot-get 1632))
        c (string/char-at page p)]
    (cond
      ((>= p (slot-get 1632)) acc)
      ((= c 42) (do (slot-set 1633 (+ p 1)) (calc-prod-rest page (calc-mul acc (calc-factor page)))))
      ((= c 47) (do (slot-set 1633 (+ p 1)) (calc-prod-rest page (calc-div acc (calc-factor page)))))
      (true acc))))

(defn calc-sum [(page : String @ Region)] : I32
  (calc-sum-rest page (calc-prod page)))

(defn calc-sum-rest [(page : String @ Region) (acc : I32)] : I32
  (let [p (skip-ws page (slot-get 1633) (slot-get 1632))
        c (string/char-at page p)]
    (cond
      ((>= p (slot-get 1632)) acc)
      ((= c 43) (do (slot-set 1633 (+ p 1)) (calc-sum-rest page (+ acc (calc-prod page)))))
      ((= c 45) (do (slot-set 1633 (+ p 1)) (calc-sum-rest page (- acc (calc-prod page)))))
      (true acc))))

;; calc(...) at page[s,e) -> px (clamped at 0), % taken of pw px; -1 when it is not a calc()
(defn calc-eval [(page : String @ Region) (s : I32) (e : I32) (pw : I32)] : I32
  (let [o (find-in page 40 s e)
        c (if (< o 0) e (paren-close page (+ o 1) e))
        a (slot-set 1633 (+ o 1))
        b (slot-set 1632 c)
        d (slot-set 1634 pw)
        v (calc-sum page)
        r (slot-set 1634 16)]
    (cond
      ((< o 0) -1)
      ((< v 0) 0)
      (true (/ (+ v 50) 100)))))

(defn parse-len [(page : String @ Region) (s0 : I32) (e0 : I32)] : I32
  (let [s (skip-ws page s0 e0)
        e (trim-end page s e0)]
    (cond
      ((>= s e) -1)
      ((= (word-eq page s e "auto") 1) 0)
      ((= (has-at page s e "calc(") 1) (calc-eval page s e 16))
      ((or (digit? (string/char-at page s)) (= (string/char-at page s) 46)) (len-num page s e))
      (true -1))))


(defn min255 [(v : I32)] : I32
  (if (> v 255) 255 v))

(defn has-tok [(page : String @ Region) (vs : I32) (ve : I32) (lit : String @ Region)] : I32
  (loop [k vs]
    (let [a (skip-ws page k ve)]
      (if (>= a ve)
        0
        (let [b (tok-end page a ve)]
          (if (= (word-eq page a b lit) 1) 1 (recur b)))))))

(defn frac-digit [(page : String @ Region) (p : I32) (e : I32)] : I32
  (if (and (< p e) (digit? (string/char-at page p)))
    (- (string/char-at page p) 48)
    0))

(defn push-len [(v : I32)] : I32
  (if (< v 0)
    0
    (let [n (slot-get 608)]
      (do (slot-set (+ 604 n) v)
          (slot-set 608 (+ n 1))
          0))))

;; up to four lengths of a margin/padding value -> slots 604-607, count in 608
(defn parse-lens [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (do (slot-set 608 0)
      (loop [k vs]
        (let [a (skip-ws page k ve)]
          (if (or (>= a ve) (>= (slot-get 608) 4))
            (slot-get 608)
            (let [b (tok-end page a ve)
                  st (push-len (if (= (word-eq page a b "auto") 1) 100000 (parse-len page a b)))]
              (recur b)))))))

;; ---- style stack ----
(defn eaddr [(d : I32) (f : I32)] : I32
  (+ 300 (+ (* d 24) f)))

(defn eget [(d : I32) (f : I32)] : I32
  (slot-get (eaddr d f)))

(defn eset [(d : I32) (f : I32) (v : I32)] : I32
  (slot-set (eaddr d f) v))

(defn tget [(f : I32)] : I32
  (eget (slot-get 31) f))

(defn tset [(f : I32) (v : I32)] : I32
  (eset (slot-get 31) f v))

(defn rows-of [(px : I32)] : I32
  (/ (+ px 17) 18))

(defn lh [(scale : I32)] : I32
  (if (>= scale 3) 2 1))

(defn set-color [(ren : I32) (c : I32)] : I32
  (sdl2-raw-set-draw-color ren (/ c 65536) (mod (/ c 256) 256) (mod c 256) 255))

(defn init-root [(width : I32)] : I32
  (do (eset 0 0 0) (eset 0 1 -1) (eset 0 2 -1) (eset 0 3 2) (eset 0 4 0)
      (eset 0 5 0) (eset 0 6 0) (eset 0 7 width) (eset 0 8 0) (eset 0 9 0)
      (eset 0 10 0) (eset 0 11 1) (eset 0 12 0) (eset 0 13 0) (eset 0 14 0)
      (eset 0 15 0) (eset 0 16 0) (eset 0 17 0) (eset 0 18 0) (eset 0 19 0)
      (eset 0 20 -1) (eset 0 21 0) (eset 0 22 0) (eset 0 23 width)
      0))

(defn flex-reset [] : I32
  (do (slot-set 610 0) (slot-set 616 0) (slot-set 614 0) 0))

(defn gap-reset [] : I32
  (do (slot-set 620 0) (slot-set 619 0) 0))

;; a hidden element ending hands "the line before it was blank" to the newline that follows it (v1.8)
(defn hide-end [] : I32
  (do (slot-set 635 (slot-get 637)) (slot-set 29 0)))

;; text decoration (v1.8): an entry marks itself in field 21 (20 underline, 21 line-through) and bumps slot 631/632
;; kind 22 = `text-decoration: none`: suppresses the link underline for the entry and its descendants (slot 4003 depth)
(defn deco-slot [(kind : I32)] : I32
  (if (= kind 22) 4003 (+ 611 kind)))

(defn deco-mark [(kind : I32)] : I32
  (if (= (tget 21) 0)
    (do (tset 21 kind) (slot-set (deco-slot kind) (+ (slot-get (deco-slot kind)) 1)) 0)
    0))

(defn deco-release [(sp : I32)] : I32
  (let [k (eget sp 21)]
    (if (or (= k 20) (or (= k 21) (= k 22)))
      (slot-set (deco-slot k) (- (slot-get (deco-slot k)) 1))
      0)))

(defn pop-entry [] : I32
  (let [sp (slot-get 31)
        dr (deco-release sp)
        a (if (= (slot-get 29) sp) (hide-end) 0)
        f (if (= (slot-get 610) sp) (flex-reset) 0)
        g (if (= (slot-get 620) sp) (gap-reset) 0)]
    (if (> sp 0) (slot-set 31 (- sp 1)) 0)))

;; new entry inheriting fg/scale/bold; inline entries inherit an inline parent's bg too
(defn push-entry [(h : I32) (blk : I32)] : I32
  (let [p (slot-get 31)
        d (+ p 1)
        inh (if (and (= blk 0) (= (eget p 11) 0)) (eget p 2) -1)]
    (do (slot-set 31 d)
        (eset d 0 h) (eset d 1 (eget p 1)) (eset d 2 inh) (eset d 3 (eget p 3)) (eset d 4 (eget p 4))
        (eset d 5 (eget p 6)) (eset d 6 (eget p 6)) (eset d 7 (eget p 7)) (eset d 23 (eget p 23))
        (eset d 8 0) (eset d 9 8421504) (eset d 10 0) (eset d 11 blk)
        (eset d 12 0) (eset d 13 0) (eset d 14 0) (eset d 15 0)
        (eset d 16 0) (eset d 17 0) (eset d 18 0) (eset d 19 0)
        (eset d 20 -1) (eset d 21 0) (eset d 22 0)
        0)))

;; ---- filling: block backgrounds and borders, per row, lazily ----
(defn fill-rect-col [(ren : I32) (c : I32) (x : I32) (y : I32) (w : I32) (h : I32)] : I32
  (do (set-color ren c)
      (sdl2-raw-render-fill-rect ren x y w h)))

(defn bars [(ren : I32) (d : I32) (x : I32) (y : I32) (w : I32) (h : I32)] : I32
  (let [bw (eget d 8)
        c (set-color ren (eget d 9))
        l (sdl2-raw-render-fill-rect ren x y bw h)]
    (if (= (eget d 22) 1)
      0
      (sdl2-raw-render-fill-rect ren (- (+ x w) bw) y bw h))))

(defn fill-ent [(d : I32) (r : I32) (h : I32)] : I32
  (if (= (eget d 11) 1)
    (let [ren (slot-get 38)
          x (+ (slot-get 36) (eget d 5))
          y (+ (slot-get 37) (* (- r (slot-get 34)) 18))
          w (- (eget d 7) (eget d 5))
          a (if (>= (eget d 2) 0) (fill-rect-col ren (eget d 2) x y w h) 0)]
      (if (> (eget d 8) 0) (bars ren d x y w h) 0))
    0))

;; first style-stack entry to paint on row r: flex children after the first skip the container chain on rows
;; the earlier columns already painted
(defn fill-start [(r : I32)] : I32
  (if (and (and (> (slot-get 610) 0) (>= (slot-get 616) 2)) (< r (slot-get 614)))
    (+ (slot-get 610) 1)
    1))

;; draw bg/borders of row r for style-stack entries 1..upto (h = pixel height of that line)
(defn fill-row [(r : I32) (upto : I32) (h : I32)] : I32
  (if (or (< r (slot-get 34)) (>= r (+ (slot-get 34) (slot-get 35))))
    0
    (loop [d (fill-start r)]
      (if (> d upto)
        0
        (let [x (fill-ent d r h)] (recur (+ d 1)))))))

(defn ensure-fill [(r : I32)] : I32
  (if (= (slot-get 27) r)
    0
    (do (slot-set 27 r)
        (fill-row r (slot-get 31) (* 18 (lh (tget 3)))))))

(defn blank-rows [(n : I32) (upto : I32)] : I32
  (loop [k 0]
    (if (>= k n)
      0
      (let [f (fill-row (slot-get 33) upto 18)
            r (slot-set 33 (+ (slot-get 33) 1))]
        (recur (+ k 1))))))

;; margin rows collapse with the margin rows emitted just before them: slot 1656 = length of the current run of
;; margin-only blank rows, 1657 = the row the cursor stood on when it ended (anything drawn since moves the row on)
(defn margin-rows [(n : I32) (upto : I32)] : I32
  (let [t (if (= (slot-get 1657) (slot-get 33)) (slot-get 1656) 0)
        e (if (> n t) (- n t) 0)
        b (blank-rows e upto)]
    (if (> n 0)
      (do (slot-set 1656 (if (> n t) n t)) (slot-set 1657 (slot-get 33)))
      0)))

(defn hline [(y : I32)] : I32
  (let [ren (slot-get 38)
        d (slot-get 31)]
    (fill-rect-col ren (tget 9) (+ (slot-get 36) (tget 5)) y (- (tget 7) (tget 5)) 2)))

(defn row-y [(r : I32)] : I32
  (+ (slot-get 37) (* (- r (slot-get 34)) 18)))

(defn row-vis? [(r : I32)] : Bool
  (and (>= r (slot-get 34)) (< r (+ (slot-get 34) (slot-get 35)))))

;; ---- line cursor ----
(defn hidden? [] : Bool
  (> (slot-get 29) 0))

(defn next-line [] : I32
  (do (slot-set 33 (+ (slot-get 33) (lh (tget 3))))
      (slot-set 32 (tget 6))
      0))

(defn end-line [] : I32
  (if (and (not (hidden?)) (> (slot-get 32) (tget 6)))
    (next-line)
    0))

(defn do-br [] : I32
  (if (hidden?) 0 (next-line)))

(defn do-hr [] : I32
  (if (hidden?)
    0
    (let [e (end-line)
          r (slot-get 33)
          f (fill-row r (slot-get 31) 18)
          ln (if (row-vis? r)
               (fill-rect-col (slot-get 38) 6316128 (+ (slot-get 36) (tget 6)) (+ (row-y r) 8) (- (tget 7) (tget 6)) 2)
               0)
          n (slot-set 33 (+ r 1))]
      (slot-set 32 (tget 6)))))

;; drop line-scoped markdown entries (heading, quote, **bold**, `code`) at a newline
(defn md-pop-line [] : I32
  (loop [k 0]
    (if (and (> (slot-get 31) 0) (>= (tget 21) 1) (<= (tget 21) 3))
      (let [p (pop-entry)] (recur (+ k 1)))
      0)))

;; HTML documents (an <html> or <body> was seen) collapse whitespace like a browser: slot 1660 = 1, slot 1658 =
;; hash of "pre". A newline/space is then one space, and none at the start of a line or after another space.
(defn pre-open [] : I32
  (loop [d (slot-get 31)]
    (if (< d 1)
      0
      (if (= (eget d 0) (slot-get 1658)) 1 (recur (- d 1))))))

(defn soft-ws? [] : I32
  (if (and (= (slot-get 1660) 1)
           (and (= (slot-get 28) 0)
                (and (not (hidden?))
                     (and (= (pre-open) 0)
                          (not (and (>= (tget 21) 1) (<= (tget 21) 3)))))))
    1
    0))

(defn soft-skip? [(page : String @ Region) (i : I32)] : I32
  (if (or (<= (slot-get 32) (tget 6))
          (and (> i 0) (ws? (string/char-at page (- i 1)))))
    1
    0))

(defn do-newline [] : I32
  (cond
    ((hidden?) (md-pop-line))
    ((and (> (slot-get 1656) 0) (and (= (slot-get 1657) (slot-get 33)) (<= (slot-get 32) (tget 6))))
     (md-pop-line))
    ((and (= (slot-get 635) 1) (<= (slot-get 32) (tget 6)))
     (do (slot-set 635 0) (md-pop-line)))
    (true (let [a (ensure-fill (slot-get 33))
                s (slot-set 635 0)
                t (slot-set 636 1)
                b (next-line)]
            (md-pop-line)))))

;; ---- drawing one character cell ----
(defn link-hit [(px : I32) (py : I32) (cw : I32) (ch : I32) (hs : I32) (he : I32)] : I32
  (if (and (>= (slot-get 13) px) (< (slot-get 13) (+ px cw)) (>= (slot-get 14) py) (< (slot-get 14) (+ py ch)))
    (do (slot-set 15 hs) (slot-set 16 he) 0)
    0))

(defn inline-bg [] : I32
  (if (= (tget 11) 0) (tget 2) -1))

;; glyph color: link blue (inverse when selected), fresh bytes amber, author color, default grey
;; 1 when the innermost open <a> (or something inside it) was given a colour by a stylesheet rule / style=""
(defn link-color? [] : I32
  (if (= (slot-get 24) 0)
    0
    (let [h (hash-range "a" 0 1)]
      (loop [d (slot-get 31)]
        (if (< d 1)
          0
          (if (= (eget d 0) h) (xget d 9) (recur (- d 1))))))))

(defn link-glyph [(ren : I32)] : I32
  (if (and (= (link-color?) 1) (>= (tget 1) 0))
    (set-color ren (tget 1))
    (sdl2-raw-set-draw-color ren 96 165 250 255)))

(defn glyph-color [(ren : I32) (i : I32) (revealed : I32) (hs : I32) (ord : I32)] : I32
  (cond
    ((>= hs 0)
     (if (= ord (slot-get 18))
       (sdl2-raw-set-draw-color ren 18 18 18 255)
       (link-glyph ren)))
    ((and (= (slot-get 11) 1) (< (- revealed i) 160))
     (sdl2-raw-set-draw-color ren 255 176 64 255))
    ((>= (tget 1) 0) (set-color ren (tget 1)))
    (true (sdl2-raw-set-draw-color ren 216 216 216 255))))

(defn sel-bar [(ren : I32) (hs : I32) (ord : I32) (px : I32) (py : I32) (cw : I32) (ch : I32)] : I32
  (if (and (>= hs 0) (= ord (slot-get 18)))
    (fill-rect-col ren 6333946 px py cw ch)
    0))

(defn draw-vis [(c : I32) (i : I32) (revealed : I32) (hs : I32) (he : I32) (ord : I32)
                (s : I32) (cw : I32) (r : I32) (col : I32)] : I32
  (let [ren (slot-get 38)
        px (+ (slot-get 36) col)
        py (row-y r)
        ch (* 18 (lh s))
        ef (ensure-fill r)
        bgc (inline-bg)
        b1 (if (>= bgc 0) (fill-rect-col ren bgc px py cw ch) 0)
        b2 (sel-bar ren hs ord px py cw ch)
        gc (glyph-color ren i revealed hs ord)
        g1 (draw-glyph ren c px py s)
        g2 (if (= (tget 4) 1) (draw-glyph ren c (+ px 1) py s) 0)
        u (if (and (>= hs 0) (= (slot-get 4003) 0)) (sdl2-raw-render-fill-rect ren px (+ py (- ch 1)) cw 1) 0)
        h (if (>= hs 0) (link-hit px py cw ch hs he) 0)
        d1 (if (> (slot-get 631) 0) (sdl2-raw-render-fill-rect ren px (+ py (- ch 2)) cw 1) 0)
        d2 (if (> (slot-get 632) 0) (sdl2-raw-render-fill-rect ren px (+ py (/ ch 2)) cw 1) 0)]
    0))

(defn wrap-if [(cw : I32)] : I32
  (if (and (> (+ (slot-get 32) cw) (tget 23)) (> (slot-get 32) (tget 6)))
    (next-line)
    0))

;; word wrap (v1.12, found dogfooding MIXFORGE: paragraphs broke mid-word, "compu|ted"): before the first character of a
;; word in an HTML document, start a new line if the whole word will not fit and a line of its own would hold it.
;; Length is counted in raw bytes up to whitespace or '<' (an entity over-counts, which only wraps early).
;; a collapsed space that would start the next line is the line break itself: wrap and drop it (no leading space)
(defn space-wraps? [] : I32
  (if (and (> (+ (slot-get 32) (* 6 (tget 3))) (tget 23)) (> (slot-get 32) (tget 6))) 1 0))

(defn word-len [(page : String @ Region) (i : I32) (lim : I32)] : I32
  (loop [k i]
    (if (or (>= k lim) (>= (- k i) 80))
      (- k i)
      (let [c (string/char-at page k)]
        (if (or (<= c 32) (= c 60)) (- k i) (recur (+ k 1)))))))

(defn word-wrap [(page : String @ Region) (i : I32) (lim : I32)] : I32
  (let [p (if (> i 0) (string/char-at page (- i 1)) 32)]
    (if (and (= (soft-ws?) 1) (or (<= p 32) (= p 62)))
      (let [n (* (word-len page i lim) (* 6 (tget 3)))
            x (slot-get 32)]
        (if (and (> (+ x n) (tget 23)) (and (> x (tget 6)) (<= n (- (tget 23) (tget 6)))))
          (next-line)
          0))
      0)))

(defn do-clear-nl [] : I32
  (do (slot-set 635 0) (slot-set 636 0) 0))

(defn put-char-raw [(c : I32) (i : I32) (revealed : I32) (hs : I32) (he : I32) (ord : I32)] : I32
  (if (hidden?)
    0
    (let [s (tget 3)
          cw (* 6 s)
          w (wrap-if cw)
          r (slot-get 33)
          col (slot-get 32)
          v (if (row-vis? r) (draw-vis c i revealed hs he ord s cw r col) 0)
          cl (if (> c 32) (do-clear-nl) 0)]
      (slot-set 32 (+ col cw)))))

;; text-transform (CSS3): upper/lower/capitalize letters as they are drawn (ASCII; the glyph set is ASCII)
(defn tt-char [(c : I32)] : I32
  (let [m0 (xget (slot-get 31) 7)
        m (if (= (slot-get 24) 1) m0 0)
        prev (slot-get 1639)
        up (if (and (>= c 97) (<= c 122)) (- c 32) c)
        lo (if (and (>= c 65) (<= c 90)) (+ c 32) c)
        r (cond
            ((= m 1) up)
            ((= m 2) lo)
            ((= m 3) (if (= prev 0) up c))
            (true c))
        sv (slot-set 1639 (if (or (letter? c) (digit? c)) 1 0))]
    r))

(defn put-char [(c : I32) (i : I32) (revealed : I32) (hs : I32) (he : I32) (ord : I32)] : I32
  (put-char-raw (tt-char c) i revealed hs he ord))

;; ---- opening and closing elements ----
(defn name-end [(page : String @ Region) (s : I32) (lim : I32)] : I32
  (if (and (< s lim) (letter? (string/char-at page s)))
    (loop [k s]
      (if (and (< k lim)
               (or (letter? (string/char-at page k)) (digit? (string/char-at page k))))
        (recur (+ k 1))
        k))
    s))

;; UA element ids (25 dl, 26 dd, 27 figure; 24 underline u/ins): 1-6 h1-h6, 7 p, 8 generic block, 9 li, 10 bold, 11 code, 12 em, 13 small, 14 big,
;; 15 mark, 16 pre, 17 blockquote, 18 body/html, 19 font, 20 ul/ol, 21 hidden (template/svg/...), 23 dim (del/s), 0 plain inline
(defn ua-id [(page : String @ Region) (a : I32) (b : I32)] : I32
  (cond
    ((= (word-eq page a b "h1") 1) 1)
    ((= (word-eq page a b "h2") 1) 2)
    ((= (word-eq page a b "h3") 1) 3)
    ((= (word-eq page a b "h4") 1) 4)
    ((= (word-eq page a b "h5") 1) 5)
    ((= (word-eq page a b "h6") 1) 6)
    ((= (word-eq page a b "p") 1) 7)
    ((= (word-eq page a b "li") 1) 9)
    ((= (word-eq page a b "ul") 1) 20)
    ((= (word-eq page a b "ol") 1) 20)
    ((= (word-eq page a b "b") 1) 10)
    ((= (word-eq page a b "strong") 1) 10)
    ((= (word-eq page a b "code") 1) 11)
    ((= (word-eq page a b "kbd") 1) 11)
    ((= (word-eq page a b "tt") 1) 11)
    ((= (word-eq page a b "em") 1) 12)
    ((= (word-eq page a b "i") 1) 12)
    ((= (word-eq page a b "small") 1) 13)
    ((= (word-eq page a b "big") 1) 14)
    ((= (word-eq page a b "mark") 1) 15)
    ((= (word-eq page a b "pre") 1) 16)
    ((= (word-eq page a b "blockquote") 1) 17)
    ((= (word-eq page a b "body") 1) 18)
    ((= (word-eq page a b "html") 1) 18)
    ((= (word-eq page a b "font") 1) 19)
    ((= (word-eq page a b "div") 1) 8)
    ((= (word-eq page a b "section") 1) 8)
    ((= (word-eq page a b "article") 1) 8)
    ((= (word-eq page a b "header") 1) 8)
    ((= (word-eq page a b "footer") 1) 8)
    ((= (word-eq page a b "nav") 1) 8)
    ((= (word-eq page a b "main") 1) 8)
    ((= (word-eq page a b "aside") 1) 8)
    ((= (word-eq page a b "form") 1) 8)
    ((= (word-eq page a b "table") 1) 8)
    ((= (word-eq page a b "tr") 1) 8)
    ((= (word-eq page a b "dl") 1) 25)
    ((= (word-eq page a b "dd") 1) 26)
    ((= (word-eq page a b "dt") 1) 8)
    ((= (word-eq page a b "address") 1) 8)
    ((= (word-eq page a b "figure") 1) 27)
    ((= (word-eq page a b "figcaption") 1) 8)
    ((= (word-eq page a b "fieldset") 1) 8)
    ((= (word-eq page a b "legend") 1) 8)
    ((= (word-eq page a b "details") 1) 8)
    ((= (word-eq page a b "summary") 1) 8)
    ((= (word-eq page a b "hgroup") 1) 8)
    ((= (word-eq page a b "menu") 1) 20)
    ((= (word-eq page a b "dir") 1) 20)
    ((= (word-eq page a b "center") 1) 8)
    ((= (word-eq page a b "caption") 1) 8)
    ((= (word-eq page a b "thead") 1) 8)
    ((= (word-eq page a b "tbody") 1) 8)
    ((= (word-eq page a b "tfoot") 1) 8)
    ((= (word-eq page a b "search") 1) 8)
    ((= (word-eq page a b "optgroup") 1) 8)
    ((= (word-eq page a b "option") 1) 8)
    ((= (word-eq page a b "dialog") 1) 8)
    ((= (word-eq page a b "template") 1) 21)
    ((= (word-eq page a b "datalist") 1) 21)
    ((= (word-eq page a b "noembed") 1) 21)
    ((= (word-eq page a b "svg") 1) 21)
    ((= (word-eq page a b "math") 1) 21)
    ((= (word-eq page a b "iframe") 1) 21)
    ((= (word-eq page a b "map") 1) 21)
    ((= (word-eq page a b "area") 1) 21)
    ((= (word-eq page a b "source") 1) 21)
    ((= (word-eq page a b "track") 1) 21)
    ((= (word-eq page a b "param") 1) 21)
    ((= (word-eq page a b "object") 1) 21)
    ((= (word-eq page a b "embed") 1) 21)
    ((= (word-eq page a b "del") 1) 23)
    ((= (word-eq page a b "s") 1) 23)
