    ((= (word-eq page s e "dimgray") 1) 6908265)
    ((= (word-eq page s e "dimgrey") 1) 6908265)
    ((= (word-eq page s e "dodgerblue") 1) 2003199)
    ((= (word-eq page s e "firebrick") 1) 11674146)
    ((= (word-eq page s e "floralwhite") 1) 16775920)
    ((= (word-eq page s e "forestgreen") 1) 2263842)
    ((= (word-eq page s e "fuchsia") 1) 16711935)
    ((= (word-eq page s e "gainsboro") 1) 14474460)
    ((= (word-eq page s e "ghostwhite") 1) 16316671)
    ((= (word-eq page s e "gold") 1) 16766720)
    ((= (word-eq page s e "goldenrod") 1) 14329120)
    ((= (word-eq page s e "gray") 1) 8421504)
    ((= (word-eq page s e "green") 1) 32768)
