(defn fm-load [(k : I32) (kind : I32) (page : String @ Region) (ne : I32) (te : I32)] : I32
  (let [s (attr-start page ne te "value=")
        e (if (< s 0) -1 (href-end page s te))]
    (cond
      ((or (= kind 4) (= kind 5)) (fm-init-check k page ne te))
      ((or (= kind 1) (= kind 2)) (if (< e 0) (fm-set k 1 0) (fm-copy k page s e)))
      (true (fm-set k 1 0)))))

(defn fm-sync [(k : I32) (kind : I32) (nh : I32) (page : String @ Region) (ne : I32) (te : I32)] : I32
  (do (fm-set k 4 kind)
      (fm-set k 5 nh)
      (if (< (fm-get k 1) 0) (fm-load k kind page ne te) 0)))

(defn fm-eat [] : I32
