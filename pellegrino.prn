(defn sel-live [(k : I32) (page : String @ Region) (ne : I32) (te : I32) (lim : I32)] : I32
  (let [ini (if (< (fm-get k 1) 0) (fm-set k 2 (opt-selected page te lim)) 0)
            nh (fm-name-hash page ne te)
            sy (fm-sync k 7 nh page ne te)
            cnt (opt-nth page te lim -1)
            i0 (fm-get k 2)
            idx (if (>= i0 cnt) 0 i0)
            o (opt-nth page te lim idx)]
    (sel-box k page o lim cnt)))

(defn select-open [(page : String @ Region) (ns : I32) (ne : I32) (te : I32)] : I32
  (let [d (if (hidden?) 0 (sel-draw page ne te))
        cl (do-clear-nl)]
