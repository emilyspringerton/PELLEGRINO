;; <select>: a "[ label v ]" box showing the chosen <option>; a click steps to the next one (entry +2 = index)
(defn sel-lim [(page : String @ Region) (pos : I32) (n : I32)] : I32
  (loop [i pos]
    (if (>= (+ i 8) n)
      n
      (if (= (match-at page i "</select") 1) i (recur (+ i 1))))))

;; start of the idx-th <option (or -1); idx < 0 counts them (returns the count)
(defn opt-nth [(page : String @ Region) (from : I32) (lim : I32) (idx : I32)] : I32
  (loop [i from c 0]
    (if (>= (+ i 7) lim)
      (if (< idx 0) c -1)
      (if (= (match-at page i "<option") 1)
        (if (= c idx) i (recur (+ i 7) (+ c 1)))
        (recur (+ i 1) c)))))

(defn opt-selected [(page : String @ Region) (from : I32) (lim : I32)] : I32
  (loop [i from c 0]
    (if (>= (+ i 7) lim)
      0
      (if (= (match-at page i "<option") 1)
        (let [gt (find-in page 62 i lim)]
          (if (and (>= gt 0) (= (bool-attr? page (+ i 7) gt "selected") 1))
            c
            (recur (+ i 7) (+ c 1))))
        (recur (+ i 1) c)))))

(defn opt-label-end [(page : String @ Region) (ls : I32) (lim : I32)] : I32
  (loop [i ls]
    (if (or (>= i lim) (or (= (string/char-at page i) 60) (or (= (string/char-at page i) 10) (>= (- i ls) 24))))
      i
      (recur (+ i 1)))))

