      (let [a (slot-set (+ 660 (* n 2)) pos)
            b (slot-set (+ 661 (* n 2)) 1)]
        (slot-set 638 (+ n 1))))))

(defn tg-flip [(pos : I32)] : I32
  (let [k (tg-find pos)]
    (if (>= k 0)
      (slot-set (+ 661 (* k 2)) (- 1 (slot-get (+ 661 (* k 2)))))
      (tg-add pos))))

(defn tg-state [(pos : I32)] : I32
  (let [k (tg-find pos)]
    (if (>= k 0) (slot-get (+ 661 (* k 2))) 0)))

(defn details-hide [] : I32
