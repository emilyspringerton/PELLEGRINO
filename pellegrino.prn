        b (if (and vis (> n 0)) (fm-label page ls le2 (+ (slot-get 36) col) (row-y r) sc) 0)
        d (if vis (sel-arrow col w r sc) 0)
        h (if (and vis (and (> cnt 1) (fm-hit? col w))) (fm-cycle k cnt) 0)]
    (slot-set 32 (+ col (+ w cw)))))

(defn sel-draw [(page : String @ Region) (ne : I32) (te : I32)] : I32
  (let [pos (slot-get 621)
        k (fm-entry pos)]
    (if (< k 0)
      0
      (let [lim (sel-lim page te (slot-get 617))
