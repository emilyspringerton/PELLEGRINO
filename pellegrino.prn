        nx (slot-set 640 (+ idx 1))]
    (cond
      ((hidden?) 0)
      ((and (< idx 8) (and (> idx 0) (< (slot-get 32) x))) (slot-set 32 x))
      (true (cell-gap)))))

(defn tr-close [(page : String @ Region) (ns : I32) (ne : I32)] : I32
