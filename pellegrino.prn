;; <textarea>: an editable one-line field seeded from its content (newlines dropped)
(defn area-end [(page : String @ Region) (from : I32) (n : I32)] : I32
  (loop [i from]
    (if (>= (+ i 10) n)
      -1
      (if (= (match-at page i "</textarea") 1) i (recur (+ i 1))))))

(defn area-draw [(page : String @ Region) (ne : I32) (te : I32)] : I32
  (let [e (area-end page (+ te 1) (slot-get 617))
        k (if (< e 0) -1 (fm-entry (slot-get 621)))]
    (if (< k 0)
      0
      (let [ld (if (< (fm-get k 1) 0) (fm-copy k page (+ te 1) e) 0)
            nh (fm-name-hash page ne te)
            sy (fm-sync k 1 nh page ne te)
            cols (attr-int page ne te "cols=")
            size (cond ((< cols 4) 30) ((> cols 40) 40) (true cols))]
        (fm-field k size 0)))))

(defn area-open [(page : String @ Region) (ns : I32) (ne : I32) (te : I32)] : I32
  (let [d (if (hidden?) 0 (area-draw page ne te))
        cl (do-clear-nl)]
    (push-styled page ns ne te)))

;; <progress> / <meter>: "[####------]"; no value on <progress> = "[~~~~~~~~~~]"
(defn num100 [(page : String @ Region) (ne : I32) (te : I32) (lit : String @ Region) (dflt : I32)] : I32
  (let [s (attr-start page ne te lit)
        e (if (< s 0) -1 (href-end page s te))]
    (if (< e 0)
      dflt
      (let [ip (scan-int page s e)
            p (slot-get 601)
            hasf (and (< p e) (= (string/char-at page p) 46))
            f1 (if hasf (frac-digit page (+ p 1) e) 0)
            f2 (if hasf (frac-digit page (+ p 2) e) 0)]
        (+ (* ip 100) (+ (* f1 10) f2))))))

(defn bar-cells [(filled : I32) (ch : I32)] : I32
  (loop [k 0]
    (if (>= k 10)
      0
      (let [p (put-char (if (< k filled) ch 45) 0 1000 -1 -1 -1)] (recur (+ k 1))))))

(defn bar-draw [(page : String @ Region) (ns : I32) (ne : I32) (te : I32)] : I32
  (let [ism (word-eq page ns ne "meter")
        mx (num100 page ne te "max=" 100)
        mn (if (= ism 1) (num100 page ne te "min=" 0) 0)
        v (num100 page ne te "value=" 0)
        none (if (and (= ism 0) (< (attr-start page ne te "value=") 0)) 1 0)
        span (- mx mn)
        f0 (if (<= span 0) 0 (/ (* (- v mn) 10) span))
        f (cond ((< f0 0) 0) ((> f0 10) 10) (true f0))
        a (put-char 91 0 1000 -1 -1 -1)
        b (if (= none 1) (bar-cells 10 126) (bar-cells f 35))
        c (put-char 93 0 1000 -1 -1 -1)]
    (put-char 32 0 1000 -1 -1 -1)))

(defn bar-open [(page : String @ Region) (ns : I32) (ne : I32) (te : I32)] : I32
  (let [d (if (hidden?) 0 (bar-draw page ns ne te))
        cl (do-clear-nl)]
    (push-styled page ns ne te)))

;; a <head> that was never closed ends at the first element that cannot live in one
(defn head-child? [(page : String @ Region) (ns : I32) (ne : I32)] : I32
  (cond
    ((= (word-eq page ns ne "title") 1) 1)
    ((= (word-eq page ns ne "meta") 1) 1)
    ((= (word-eq page ns ne "link") 1) 1)
    ((= (word-eq page ns ne "script") 1) 1)
    ((= (word-eq page ns ne "style") 1) 1)
    ((= (word-eq page ns ne "base") 1) 1)
    ((= (word-eq page ns ne "noscript") 1) 1)
    ((= (word-eq page ns ne "template") 1) 1)
    (true 0)))

(defn head-close [(page : String @ Region) (ns : I32) (ne : I32)] : I32
  (let [d (find-open (hash-range "head" 0 4))]
    (if (and (> d 0) (= (head-child? page ns ne) 0)) (close-to d) 0)))

;; a heading or paragraph that starts right after bare inline text on the line gets the gap CSS margins give it
(defn pre-break [(ua : I32)] : I32
  (end-line))

(defn open-named [(page : String @ Region) (ns : I32) (ne : I32) (te : I32)] : I32
  (cond
    ((= (word-eq page ns ne "br") 1) (do-br))
    ((= (word-eq page ns ne "hr") 1) (do-hr))
    ((= (word-eq page ns ne "img") 1) (img-open page ne te))
    ((= (word-eq page ns ne "meta") 1) 0)
    ((= (word-eq page ns ne "link") 1) 0)
    ((= (word-eq page ns ne "input") 1) (fm-input page ns ne te))
    ((= (word-eq page ns ne "button") 1) (fm-button-open page ns ne te))
    ((= (word-eq page ns ne "form") 1) (form-open page ns ne te))
    ((= (word-eq page ns ne "base") 1) 0)
    ((= (word-eq page ns ne "wbr") 1) 0)
    ((= (void-tag? page ns ne) 1) 0)
    ((= (string/char-at page (- te 1)) 47) 0)
    ((or (= (word-eq page ns ne "td") 1) (= (word-eq page ns ne "th") 1)) (cell-open page ns ne te))
    ((= (word-eq page ns ne "q") 1) (q-open page ns ne te))
    ((= (word-eq page ns ne "details") 1) (details-open page ns ne te))
    ((= (word-eq page ns ne "summary") 1) (summary-open page ns ne te))
    ((= (word-eq page ns ne "table") 1) (table-open page ns ne te))
    ((= (word-eq page ns ne "tr") 1) (tr-open page ns ne te))
    ((= (word-eq page ns ne "select") 1) (select-open page ns ne te))
    ((= (word-eq page ns ne "textarea") 1) (area-open page ns ne te))
    ((= (word-eq page ns ne "progress") 1) (bar-open page ns ne te))
    ((= (word-eq page ns ne "meter") 1) (bar-open page ns ne te))
    (true (push-styled page ns ne te))))

;; <name ...> at i: apply it (only once its closing '>' has arrived)
(defn open-tag [(page : String @ Region) (i : I32) (revealed : I32)] : I32
  (let [ns (+ i 1)
        ne (name-end page ns revealed)
        te (find-in page 62 ne revealed)
        m (slot-set 621 i)]
    (cond
      ((and (= (string/char-at page ns) 33) (= (word-eq page (+ ns 1) (+ ns 8) "doctype") 1))
       (slot-set 1660 1))
      ((or (= ne ns) (< te 0)) 0)
      (true (open-named page ns ne te)))))

(defn close-top [] : I32
  (if (= (tget 11) 1)
    (close-block (hidden?))
    (pop-entry)))

(defn close-block [(hid : Bool)] : I32
  (let [e (if hid 0 (end-line))
        isc (= (slot-get 31) (slot-get 610))
        mx (if (and isc (> (slot-get 614) (slot-get 33))) (slot-set 33 (slot-get 614)) 0)
        r1 (if hid 0 (blank-rows (tget 18) (slot-get 31)))
        bb (if (and (not hid) (> (tget 8) 0) (row-vis? (- (slot-get 33) 1)))
             (hline (- (row-y (slot-get 33)) 2))
             0)
        mb (tget 14)
        p (pop-entry)
        r2 (if hid 0 (margin-rows mb (slot-get 31)))
        isk (and (> (slot-get 610) 0) (= (+ (slot-get 31) 1) (+ (slot-get 610) 1)))
        km (if (and isk (< (slot-get 614) (slot-get 33))) (slot-set 614 (slot-get 33)) 0)]
    (if hid 0 (slot-set 32 (tget 6)))))

(defn find-open [(h : I32)] : I32
  (loop [d (slot-get 31)]
    (if (< d 1)
      0
      (if (= (eget d 0) h) d (recur (- d 1))))))

(defn close-to [(idx : I32)] : I32
  (loop [k 0]
    (if (or (< (slot-get 31) idx) (>= k 16))
      0
      (let [t (close-top)] (recur (+ k 1))))))

(defn close-generic [(page : String @ Region) (ns : I32) (ne : I32)] : I32
  (let [d (find-open (hash-range page ns ne))]
    (if (> d 0) (close-to d) 0)))

(defn form-close [(page : String @ Region) (ns : I32) (ne : I32)] : I32
  (do (fm-form-close) (close-generic page ns ne)))

(defn close-tag [(page : String @ Region) (i : I32) (revealed : I32)] : I32
  (let [ns (+ i 2)
        ne (name-end page ns revealed)]
    (cond
      ((= ne ns) 0)
      ((= (word-eq page ns ne "button") 1) (fm-button-close))
      ((= (word-eq page ns ne "form") 1)
       (form-close page ns ne))
      ((= (word-eq page ns ne "q") 1) (q-close page ns ne))
      ((= (word-eq page ns ne "summary") 1) (summary-close page ns ne))
      ((= (word-eq page ns ne "tr") 1) (tr-close page ns ne))
      (true (close-generic page ns ne)))))

;; ---- markdown (rendered through the same style stack as HTML) ----
(defn md-on? [] : Bool
  (and (= (slot-get 26) 1) (= (slot-get 25) 1)))

(defn eol [(page : String @ Region) (i : I32) (revealed : I32)] : I32
  (let [k (find-in page 10 i revealed)]
    (if (< k 0) revealed k)))

;; 10 + n for "#"*n followed by a space (n 1..6), else 0
(defn md-heading-level [(page : String @ Region) (i : I32) (revealed : I32)] : I32
  (let [n (loop [k i]
            (if (and (< k revealed) (< (- k i) 7) (= (string/char-at page k) 35))
              (recur (+ k 1))
              (- k i)))]
    (if (and (>= n 1) (<= n 6) (= (string/char-at page (+ i n)) 32))
      (+ 10 n)
      0)))

;; [text](url) at i -> 8 with slot 600 = url start, 601 = url end, 602 = ']' index; else 0
(defn md-link-kind [(page : String @ Region) (i : I32) (revealed : I32)] : I32
  (let [lim (eol page i revealed)
        j (find-in page 93 (+ i 1) lim)]
    (if (or (< j 0) (not (= (string/char-at page (+ j 1)) 40)))
      0
      (let [k (find-in page 41 (+ j 2) lim)]
        (if (< k 0)
          0
          (do (slot-set 600 (+ j 2)) (slot-set 601 k) (slot-set 602 j) 8))))))

(defn md-kind [(page : String @ Region) (i : I32) (start : I32) (revealed : I32) (hs : I32)] : I32
  (if (md-on?)
    (let [c (string/char-at page i)
          bol (or (= i start) (= (string/char-at page (- i 1)) 10))
          fence (and bol (= (match-at page i "```") 1))]
      (cond
        ((= (slot-get 28) 1) (if fence 4 0))
        (fence 4)
        ((and bol (= c 35)) (md-heading-level page i revealed))
        ((and bol (or (= c 45) (= c 42) (= c 43)) (= (string/char-at page (+ i 1)) 32)) 2)
        ((and bol (= c 62) (= (string/char-at page (+ i 1)) 32)) 3)
        ((and bol (= (match-at page i "---") 1)) 5)
        ((and (= c 42) (= (string/char-at page (+ i 1)) 42)) 6)
        ((= c 96) 7)
        ((= c 91) (md-link-kind page i revealed))
        ((and (= c 93) (>= hs 0) (= (string/char-at page (+ i 1)) 40)) 9)
        (true 0)))
    0))

(defn md-entry [(marker : I32) (ua : I32)] : I32
  (if (>= (slot-get 31) 11)
    0
    (let [p (push-entry 1 0)
          m (tset 21 marker)]
      (ua-style ua))))

(defn md-heading [(n : I32)] : I32
  (md-entry 1 n))

(defn md-bullet [(revealed : I32)] : I32
  (let [a (put-char 42 0 1000 -1 -1 -1)]
    (put-char 32 0 1000 -1 -1 -1)))

(defn md-quote [] : I32
  (let [e (md-entry 1 0)
        f (tset 1 11579568)
        a (put-char 124 0 1000 -1 -1 -1)]
    (put-char 32 0 1000 -1 -1 -1)))

(defn md-fence-open [] : I32
  (let [f (slot-set 28 1)]
    (md-entry 4 11)))

(defn md-fence-close [] : I32
  (let [f (slot-set 28 0)]
    (if (= (tget 21) 4) (pop-entry) 0)))

(defn md-fence [] : I32
  (if (= (slot-get 28) 1) (md-fence-close) (md-fence-open)))

(defn md-toggle [(marker : I32) (ua : I32)] : I32
  (if (= (tget 21) marker)
    (pop-entry)
    (md-entry marker ua)))

;; ---- the page pass ----
(defn init-draw [(ren : I32) (page : String @ Region) (start : I32) (revealed : I32) (scroll : I32)
                 (rows : I32) (x0 : I32) (y0 : I32) (width : I32)] : I32
  (do (slot-set 38 ren) (slot-set 34 scroll) (slot-set 35 rows) (slot-set 36 x0) (slot-set 37 y0)
      (slot-set 39 width) (slot-set 31 0) (slot-set 32 0) (slot-set 33 0) (slot-set 27 -1)
      (slot-set 28 0) (slot-set 29 0) (slot-set 30 0) (slot-set 297 -1) (slot-set 1086 0)
      (slot-set 610 0) (slot-set 611 0) (slot-set 613 0) (slot-set 614 0) (slot-set 616 0) (slot-set 617 revealed)
      (slot-set 619 0) (slot-set 620 0) (slot-set 1091 -1) (slot-set 1094 -1)
      (slot-set 631 0) (slot-set 632 0) (slot-set 633 0) (slot-set 634 0) (slot-set 635 0) (slot-set 4003 0)
      (slot-set 640 0) (slot-set 641 0) (slot-set 1740 0) (slot-set 1639 0)
      (slot-set 1655 0) (slot-set 1656 0) (slot-set 1657 -1) (slot-set 1658 0) (slot-set 1660 0)
      (xset 0 3 0) (xset 0 7 0) (xset 0 8 0)
      (init-root width)
      (if (= (slot-get 24) 1) (scan-styles page start revealed) 0)
      0))

(defn log-rules-n [(n : I32)] : I32
  (with-arena [fr :region/scratch 256]
    (pg-log-n "css: rules=" n &mut fr)))

(defn log-rules [] : I32
  (if (= (slot-get 30) (slot-get 298))
    0
    (let [n (slot-get 30)
          a (slot-set 298 n)]
      (log-rules-n n))))

(defn log-height-n [(n : I32)] : I32
  (with-arena [fr :region/scratch 256]
    (pg-log-n "page: rows=" n &mut fr)))

;; the laid-out height in rows, logged when it changes (what tests/smoke.sh asserts UA default margins against)
(defn log-height [] : I32
  (if (= (slot-get 1661) (slot-get 33))
    0
    (do (slot-set 1661 (slot-get 33)) (log-height-n (slot-get 33)))))

(defn page-bg-changed [] : I32
  (do (slot-set 296 (slot-get 297)) (slot-set 2 1) 0))

(defn finish-draw [(ln : I32)] : I32
  (let [a (slot-set 22 ln)
        t (slot-set 1098 (slot-get 33))
        b (if (= (slot-get 297) (slot-get 296)) 0 (page-bg-changed))
        c (log-rules)
        d (log-height)]
    (slot-get 33)))

;; tag kinds at '<': 1 script/style/title (content skipped), 3 <a ...>, 4 </a>, 5 other closer, 6 comment, 0 open
(defn tag-kind [(page : String @ Region) (i : I32)] : I32
  (let [c1 (string/char-at page (+ i 1))
        c2 (string/char-at page (+ i 2))
        c3 (string/char-at page (+ i 3))]
    (cond
      ((= (match-at page i "<!--") 1) 6)
      ((= (skip-elem? page i) 1) 1)
      ((and (or (= c1 97) (= c1 65)) (ws? c2)) 3)
      ((and (= c1 47) (or (= c2 97) (= c2 65)) (or (ws? c3) (= c3 62))) 4)
      ((= c1 47) 5)
      (true 0))))

;; ---- HTML entities + the UTF-8 punctuation people actually write (v1.6) ----
;; ent-pack returns len*4096 + code (0 = not an entity / not decodable yet). Codes < 1000 are one ASCII
;; glyph; 1001 "...", 1002 "(c)", 1003 "(tm)", 1004 "(r)", 1005 "<<", 1006 ">>", 1007 "--", 1010 nothing.
;; The font is ASCII only, so typographic quotes/dashes fold to their ASCII look-alikes.
(defn cp-map [(cp : I32)] : I32
  (cond
    ((and (>= cp 32) (< cp 127)) cp)
    ((= cp 160) 32)
    ((or (= cp 8216) (or (= cp 8217) (= cp 8218))) 39)
    ((or (= cp 8220) (or (= cp 8221) (= cp 8222))) 34)
    ((= cp 8211) 45)
    ((= cp 8212) 1007)
    ((= cp 8230) 1001)
    ((= cp 169) 1002)
    ((= cp 177) 1013)
    ((= cp 176) 111)
    ((= cp 178) 50)
    ((= cp 179) 51)
    ((= cp 181) 117)
    ((= cp 247) 47)
    ((= cp 8482) 1003)
    ((= cp 174) 1004)
    ((= cp 8226) 42)
    ((= cp 183) 46)
    ((= cp 171) 1005)
    ((= cp 187) 1006)
    ((= cp 215) 120)
    ((or (= cp 8203) (= cp 65279)) 1010)
    ((= cp 8594) 1011)
    ((= cp 8592) 1012)
    (true 63)))

(defn ent-named [(page : String @ Region) (a : I32) (b : I32)] : I32
  (cond
    ((= (word-eq page a b "amp") 1) 38)
    ((= (word-eq page a b "lt") 1) 60)
    ((= (word-eq page a b "gt") 1) 62)
    ((= (word-eq page a b "quot") 1) 34)
    ((= (word-eq page a b "apos") 1) 39)
    ((= (word-eq page a b "nbsp") 1) 32)
    ((= (word-eq page a b "lsquo") 1) 39)
    ((= (word-eq page a b "rsquo") 1) 39)
    ((= (word-eq page a b "sbquo") 1) 39)
    ((= (word-eq page a b "ldquo") 1) 34)
    ((= (word-eq page a b "rdquo") 1) 34)
    ((= (word-eq page a b "bdquo") 1) 34)
    ((= (word-eq page a b "ndash") 1) 45)
    ((= (word-eq page a b "mdash") 1) 1007)
    ((= (word-eq page a b "hellip") 1) 1001)
    ((= (word-eq page a b "copy") 1) 1002)
    ((= (word-eq page a b "trade") 1) 1003)
    ((= (word-eq page a b "reg") 1) 1004)
    ((= (word-eq page a b "bull") 1) 42)
    ((= (word-eq page a b "middot") 1) 46)
    ((= (word-eq page a b "laquo") 1) 1005)
    ((= (word-eq page a b "raquo") 1) 1006)
    ((= (word-eq page a b "times") 1) 120)
    ((= (word-eq page a b "shy") 1) 1010)
    ((= (word-eq page a b "rarr") 1) 1011)
    ((= (word-eq page a b "larr") 1) 1012)
    (true 0)))

(defn ent-hex [(page : String @ Region) (a : I32) (b : I32)] : I32
  (loop [k a v 0]
    (if (>= k b)
      v
      (let [h (hexd (string/char-at page k))]
        (if (or (< h 0) (> v 100000)) -1 (recur (+ k 1) (+ (* v 16) h)))))))

(defn ent-num [(page : String @ Region) (a : I32) (b : I32)] : I32
  (let [c (string/char-at page a)]
    (cond
      ((>= a b) 0)
      ((or (= c 120) (= c 88)) (ent-cp (ent-hex page (+ a 1) b)))
      ((digit? c) (if (= (skip-digits page a b) b) (cp-map (scan-int page a b)) 0))
      (true 0))))

(defn ent-cp [(v : I32)] : I32
  (if (< v 0) 0 (cp-map v)))

(defn ent-semi [(page : String @ Region) (i : I32) (rev : I32)] : I32
  (let [lim (if (< rev (+ i 12)) rev (+ i 12))]
    (loop [k (+ i 1)]
      (if (>= k lim)
        -1
        (let [c (string/char-at page k)]
          (cond
            ((= c 59) k)
            ((or (letter? c) (or (digit? c) (= c 35))) (recur (+ k 1)))
            (true -1)))))))

(defn amp-ent [(page : String @ Region) (i : I32) (rev : I32)] : I32
  (let [semi (ent-semi page i rev)]
    (if (< semi 0)
      0
      (let [code (if (= (string/char-at page (+ i 1)) 35)
                   (ent-num page (+ i 2) semi)
                   (ent-named page (+ i 1) semi))]
        (if (= code 0) 0 (+ (* (+ (- semi i) 1) 4096) code))))))

(defn byte-at [(page : String @ Region) (i : I32)] : I32
  (let [c (string/char-at page i)]
    (if (< c 0) (+ c 256) c)))

(defn utf-len [(c : I32)] : I32
  (cond
    ((>= c 240) 4)
    ((>= c 224) 3)
    ((>= c 192) 2)
    (true 1)))

(defn utf-cp [(page : String @ Region) (i : I32) (c : I32) (n : I32)] : I32
  (cond
    ((= n 2) (+ (* (- c 192) 64) (- (byte-at page (+ i 1)) 128)))
    ((= n 3) (+ (* (- c 224) 4096)
                (+ (* (- (byte-at page (+ i 1)) 128) 64) (- (byte-at page (+ i 2)) 128))))
    (true 63)))

(defn utf-ent [(page : String @ Region) (i : I32) (rev : I32)] : I32
  (let [c (byte-at page i)
        n (utf-len c)]
    (if (> (+ i n) rev)
      (+ (* (- rev i) 4096) 63)
      (+ (* n 4096) (cp-map (utf-cp page i c n))))))

(defn ent-pack [(page : String @ Region) (i : I32) (rev : I32)] : I32
  (let [c (byte-at page i)]
    (cond
      ((= c 38) (amp-ent page i rev))
      ((>= c 128) (utf-ent page i rev))
      (true 0))))

(defn put-lit [(a : I32) (b : I32) (c : I32)] : I32
  (let [x (put-char a 0 1000 -1 -1 -1)
        y (if (> b 0) (put-char b 0 1000 -1 -1 -1) 0)]
    (if (> c 0) (put-char c 0 1000 -1 -1 -1) 0)))

(defn put-ent [(code : I32) (i : I32) (rev : I32) (hs : I32) (he : I32) (ord : I32)] : I32
  (cond
    ((< code 1000) (put-char code i rev hs he ord))
    ((= code 1001) (put-lit 46 46 46))
    ((= code 1002) (put-lit 40 99 41))
    ((= code 1003) (put-lit 84 77 0))
    ((= code 1004) (put-lit 40 114 41))
    ((= code 1005) (put-lit 60 60 0))
    ((= code 1006) (put-lit 62 62 0))
    ((= code 1007) (put-lit 45 45 0))
    ((= code 1011) (put-lit 45 62 0))
    ((= code 1012) (put-lit 60 45 0))
    ((= code 1013) (put-lit 43 47 45))
    (true 0)))

(defn draw-page [(ren : I32) (page : String @ Region) (start : I32) (revealed : I32) (scroll : I32)
                 (cols : I32) (rows : I32) (x0 : I32) (y0 : I32)] : I32
  (let [ini (init-draw ren page start revealed scroll rows x0 y0 (* cols 12))]
    (loop [i start tag 0 hs -1 he -1 ln 0]
      (if (>= i revealed)
        (finish-draw ln)
        (let [c (string/char-at page i)]
          (cond
            ((= tag 1) (recur (+ i 1) (if (= c 62) 0 1) hs he ln))
            ((= tag 4) (recur (+ i 1) (if (= c 62) 2 4) hs he ln))
            ((= tag 2)
             (if (= (skip-end? page i) 1)
               (recur (+ i 1) 1 hs he ln)
               (recur (+ i 1) 2 hs he ln)))
            ((= tag 5)
             (recur (+ i 1)
                    (if (and (= c 62) (= (string/char-at page (- i 1)) 45) (= (string/char-at page (- i 2)) 45)) 0 5)
                    hs he ln))
            ((= c 60)
             (let [k (tag-kind page i)]
               (cond
                 ((= k 1) (recur (+ i 1) 4 hs he ln))
                 ((= k 6) (recur (+ i 4) 5 hs he ln))
                 ((= k 3)
                  (let [s (href-start page i revealed)
                        e (if (< s 0) -1 (href-end page s revealed))
                        ok (if (< e 0) -1 (note-sel ln s e (slot-get 33)))
                        t (open-tag page i revealed)]
                    (recur (+ i 1) 1 (if (< e 0) -1 s) e (if (< e 0) ln (+ ln 1)))))
                 ((= k 4) (let [t (close-tag page i revealed)] (recur (+ i 1) 1 -1 -1 ln)))
                 ((= k 5) (let [t (close-tag page i revealed)] (recur (+ i 1) 1 hs he ln)))
                 (true (let [t (open-tag page i revealed)] (recur (+ i 1) 1 hs he ln))))))
            ((and (or (= c 10) (or (= c 32) (= c 9))) (= (soft-ws?) 1))
             (let [p (cond ((= (soft-skip? page i) 1) 0) ((= (space-wraps?) 1) (next-line)) (true (put-char 32 i revealed hs he (- ln 1))))
                   q (if (= c 10) (md-pop-line) 0)]
               (recur (+ i 1) 0 hs he ln)))
            ((= c 10) (let [t (do-newline)] (recur (+ i 1) 0 hs he ln)))
            ((= c 13) (recur (+ i 1) 0 hs he ln))
            ((> (ent-pack page i revealed) 0)
             (let [pk (ent-pack page i revealed)
                   p (put-ent (mod pk 4096) i revealed hs he (- ln 1))]
               (recur (+ i (/ pk 4096)) 0 hs he ln)))
            (true
             (let [k (md-kind page i start revealed hs)]
               (cond
                 ((= k 0)
                  (let [w (word-wrap page i revealed)
                        p (put-char c i revealed hs he (- ln 1))] (recur (+ i 1) 0 hs he ln)))
                 ((>= k 11)
                  (let [p (md-heading (- k 10))] (recur (+ i (+ (- k 10) 1)) 0 hs he ln)))
                 ((= k 2) (let [p (md-bullet revealed)] (recur (+ i 2) 0 hs he ln)))
                 ((= k 3) (let [p (md-quote)] (recur (+ i 2) 0 hs he ln)))
                 ((= k 4) (let [p (md-fence)] (recur (eol page i revealed) 0 hs he ln)))
                 ((= k 5) (let [p (do-hr)] (recur (eol page i revealed) 0 hs he ln)))
                 ((= k 6) (let [p (md-toggle 2 10)] (recur (+ i 2) 0 hs he ln)))
                 ((= k 7) (let [p (md-toggle 3 11)] (recur (+ i 1) 0 hs he ln)))
                 ((= k 8)
                  (let [s (slot-get 600)
                        e (slot-get 601)
                        ok (note-sel ln s e (slot-get 33))]
                    (recur (+ i 1) 0 s e (+ ln 1))))
                 (true (recur (+ he 1) 0 -1 -1 ln)))))))))))

;; ===================== navigation, state (slots) and the frame loop =====================
;; slot 0 revealed (src 0 only)  1 scroll  2 dirty  3 mode (0 view, 1 typing a URL)
;; slot 4 socket fd (-1 none)    5 body start in stream buf (-1 until headers seen)   10 navigation generation
;; slot 6 src (0 file/embedded page, 1 live stream, 3 error page)   7 redirects   8 error code
;; slot 13/14 pending click (px x/y, -1 none)   15/16 href [start,end) of the link under it (-1 none)
;; slot 17 smoke: synthesize a click at frame 60   18-23 keyboard link selection (see note-sel)
;; slot 4010 HTTP/3 fetch in flight (1)   4011 this navigation asked for h3:// (no TCP fallback)
;; slot 4020+2k / 4021+2k Alt-Svc cache: host hash+1 (0 free) / h3 port, k < 8;  4036 next victim
(defn embedded-page [] : String
  "<h1>PELLEGRINO v1</h1>
<p>all gas; no brakes; powered by PARENA.</p>
<p>CLEAN BUILDS FIRST.</p>
<p>Press : and type a URL (http://, https:// or h3://) then Enter. Bytes are painted as they land off the wire; the newest glow amber.</p>
<p>Keys: Up/Down/Home/End or mouse wheel scroll, : address bar, Esc/q quit.</p>
<p>Start with a URL or a file path as the first argument.</p>
<p>With love, <4 America.</p>
")

(defn error-page [(code : I32)] : String
  (cond
    ((= code 1) "<h1>could not connect</h1>\n<p>DNS or TCP connect failed (5 s timeout). Check the URL, then press : and type another.</p>\n")
    ((= code 3) "<h1>bad URL</h1>\n<p>Use http://host/path or https://host/path</p>\n")
    ((= code 4) "<h1>too many redirects</h1>\n")
    ((= code 8) "<h1>HTTP/3 connection failed</h1>\n<p>The server did not answer over QUIC (UDP may be blocked, or the server has no HTTP/3). Use https:// to fall back to TCP.</p>\n")
    ((= code 9) "<h1>certificate rejected</h1>\n<p>The HTTP/3 server's certificate chain or host name did not verify. Nothing was rendered.</p>\n")
    ((>= code 5) (stream-tls-page))
    (true "<h1>error</h1>\n")))

;; 1 if s starts with p
(defn has-prefix [(s : String @ Region) (p : String @ Region)] : I32
  (let [pn (string/length p)]
    (if (< (string/length s) pn)
      0
      (loop [i 0]
        (if (>= i pn)
          1
          (if (= (string/char-at s i) (string/char-at p i))
            (recur (+ i 1))
            0))))))

;; 1 if buf has pattern p at index i (caller guarantees i + len(p) <= len(buf))
(defn match-at [(buf : String @ Region) (i : I32) (p : String @ Region)] : I32
  (let [pn (string/length p)]
    (loop [k 0]
      (if (>= k pn)
        1
        (if (= (string/char-at buf (+ i k)) (string/char-at p k))
          (recur (+ k 1))
          0)))))

(defn find-char [(s : String @ Region) (c : I32) (from : I32)] : I32
  (let [n (string/length s)]
    (loop [i from]
      (if (>= i n)
        -1
        (if (= (string/char-at s i) c)
          i
          (recur (+ i 1)))))))

;; ---- URL parts (url starts with "http://" or "https://") ----
;; 1 for https://
(defn url-https? [(url : String @ Region)] : I32
  (has-prefix url "https://"))

;; index of the first host byte: after "http://" (7) or "https://" (8)
(defn url-start [(url : String @ Region)] : I32
  (if (= (url-https? url) 1) 8 7))

(defn default-port [(url : String @ Region)] : I32
  (if (= (url-https? url) 1) 443 80))

(defn host-end [(url : String @ Region)] : I32
  (let [n (string/length url)]
    (loop [i (url-start url)]
      (if (>= i n)
        n
        (let [c (string/char-at url i)]
          (if (or (= c 58) (= c 47))
            i
            (recur (+ i 1))))))))

(defn url-host [(url : String @ Region) (dest : Arena @ Region)] : String
  (string/substring url (url-start url) (host-end url) dest))

(defn url-port [(url : String @ Region)] : I32
  (let [he (host-end url)
        n (string/length url)]
    (if (and (< he n) (= (string/char-at url he) 58))
      (loop [i (+ he 1) v 0]
        (if (>= i n)
          (if (> v 0) v (default-port url))
          (let [c (string/char-at url i)]
            (if (and (>= c 48) (<= c 57))
              (recur (+ i 1) (+ (* v 10) (- c 48)))
              (if (> v 0) v (default-port url))))))
      (default-port url))))

(defn url-path [(url : String @ Region) (dest : Arena @ Region)] : String
  (let [p (find-char url 47 (url-start url))]
    (if (< p 0)
      "/"
      (string/substring url p (string/length url) dest))))

;; scheme + host[:port] of a url (everything before the path)
(defn url-origin [(url : String @ Region) (dest : Arena @ Region)] : String
  (let [p (find-char url 47 (url-start url))]
    (if (< p 0)
      url
      (string/substring url 0 p dest))))

;; ---- navigation ----
;; Navigating away must never leak the socket (or leave a TLS session running) of the page being left:
;; every new navigation first closes whatever live stream slot 4 still holds.
;; NOTE (VS0 emitter): `do` only works as a function/let body -- inside an if/cond arm that is itself a
;; value it is emitted as a ternary and breaks. So multi-effect arms are small helper functions.
(defn nav-fail [(code : I32) (msg : String @ Region)] : I32
  (do (slot-set 6 3)
      (slot-set 8 code)
      (slot-set 2 1)
      (pg-log msg)
      0))

(defn post-head [(host : String @ Region) (path : String @ Region) (dest : Arena @ Region)] : String
  (let [body (linebuf-get)
        r1 (string/concat "POST " path dest)
        r2 (string/concat r1 " HTTP/1.0\r\nHost: " dest)
        r3 (string/concat r2 host dest)
        r4 (string/concat r3 "\r\nUser-Agent: PELLEGRINO/v1\r\nAccept: text/html,text/plain,*/*\r\nConnection: close\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: " dest)
        r5 (string/concat r4 (string/i32-to-string (string/length body) dest) dest)]
    (string/concat r5 (string/concat "\r\n\r\n" body dest) dest)))

(defn get-head [(host : String @ Region) (path : String @ Region) (dest : Arena @ Region)] : String
  (let [r1 (string/concat "GET " path dest)
        r2 (string/concat r1 " HTTP/1.0\r\nHost: " dest)
        r3 (string/concat r2 host dest)]
    (string/concat r3 "\r\nUser-Agent: PELLEGRINO/v1\r\nAccept: text/html,text/plain,*/*\r\nConnection: close\r\n\r\n" dest)))

(defn send-request [(fd : I32) (host : String @ Region) (path : String @ Region) (dest : Arena @ Region)] : I32
  (let [req (if (= (slot-get 1095) 1) (post-head host path dest) (get-head host path dest))]
    (do (slot-set 6 1)
        (slot-set 4 fd)
        (pg-log-n "connected; fd=" fd dest)
        (stream-send fd req)
        0)))

;; Host header value: host, plus :port when it is not the scheme's default
(defn host-header [(host : String @ Region) (port : I32) (url : String @ Region) (dest : Arena @ Region)] : String
  (if (= port (default-port url))
    host
    (string/concat (string/concat host ":" dest) (string/i32-to-string port dest) dest)))

;; the runtime's TLS failure class -> error-page code (1 connect, 5 secure connection failed,
;; 6 certificate rejected, 7 no CA bundle)
(defn tls-fail-code [(c : I32)] : I32
  (cond
    ((= c 1) 1)
    ((= c 3) 6)
    ((= c 4) 7)
    (true 5)))

(defn tls-failed [(dest : Arena @ Region)] : I32
  (do (pg-log (string/concat "tls FAILED: " (stream-tls-error) dest))
      (nav-fail (tls-fail-code (stream-tls-code)) "secure connection failed")))

(defn log-tls [(fd : I32) (dest : Arena @ Region)] : I32
  (do (pg-log (string/concat "tls " (stream-tls-info) dest))
      (pg-log-n "tls heap peak=" (stream-tls-heap-peak) dest)
      0))

(defn open-tls [(host : String @ Region) (port : I32) (path : String @ Region) (url : String @ Region)
                (dest : Arena @ Region)] : I32
  (let [fd (stream-connect-tls host port)]
    (if (< fd 0)
      (tls-failed dest)
      (do (log-tls fd dest)
          (send-request fd (host-header host port url dest) path dest)))))

(defn open-plain [(host : String @ Region) (port : I32) (path : String @ Region) (url : String @ Region)
                  (dest : Arena @ Region)] : I32
  (let [fd (stream-connect host port)]
    (if (< fd 0)
      (nav-fail 1 "connect FAILED")
      (send-request fd (host-header host port url dest) path dest))))

(defn open-conn [(url : String @ Region) (dest : Arena @ Region)] : I32
  (let [host (url-host url dest)
        port (url-port url)
        path (url-path url dest)]
    (if (= (url-https? url) 1)
      (open-tls host port path url dest)
      (open-plain host port path url dest))))

;; ---- HTTP/3 (v1.12) -------------------------------------------------------------------------------
;; The transport is PARENA's own (net/quic_client: QUIC v1 + TLS 1.3 + HTTP/3, certificate and host name
;; verified, no bypass). It is NON-BLOCKING: h3-begin sends the ClientHello and returns; pump-h3 (frame loop)
;; advances the connection a little each frame. When the response is complete it is handed to the SAME page
;; pipeline as TCP/TLS: an HTTP/1.1-shaped head + the body are appended to the shared stream buffer, then
;; check-headers runs (status, redirects, Alt-Svc) exactly as for a socket.
;;   h3://host[:port]/path   explicit: HTTP/3 only, failure is an error page
;;   https://host/path       upgraded to HTTP/3 once an earlier response from that host advertised
;;                           `Alt-Svc: h3=":port"`; ANY HTTP/3 failure falls back to TCP+TLS transparently
;; POST always uses TCP. Sub-resources (images, stylesheets) still use TCP+TLS.
(defn h3-scheme? [(url : String @ Region)] : I32
  (has-prefix url "h3://"))

;; "h3://host/p" -> "https://host/p"; anything else unchanged
(defn nav-url [(url : String @ Region) (dest : Arena @ Region)] : String
  (if (= (h3-scheme? url) 1)
    (string/concat "https://" (string/substring url 5 (string/length url) dest) dest)
    url))

;; small stable hash of a host name (1 .. 2^25)
(defn host-hash [(host : String @ Region)] : I32
  (let [n (string/length host)]
    (loop [i 0 h 7]
      (if (>= i n)
        (+ h 1)
        (recur (+ i 1) (mod (+ (* h 31) (bit-and (string/char-at host i) 255)) 33554393))))))

;; Alt-Svc cache key: an ORIGIN (host + port), as the RFC scopes it -- two servers on one host never share it
(defn origin-key [(url : String @ Region) (dest : Arena @ Region)] : I32
  (+ 1 (mod (+ (* (host-hash (url-host url dest)) 31) (url-port url)) 33554393)))

(defn as-find [(h : I32)] : I32
  (loop [k 0]
    (if (>= k 8)
      -1
      (if (= (slot-get (+ 4020 (* k 2))) h) k (recur (+ k 1))))))

(defn as-put [(h : I32) (port : I32)] : I32
  (let [e (as-find h)
        k (if (>= e 0) e (mod (slot-get 4036) 8))]
    (do (slot-set (+ 4020 (* k 2)) h)
        (slot-set (+ 4021 (* k 2)) port)
        (if (< e 0) (slot-set 4036 (+ (slot-get 4036) 1)) 0)
        0)))

(defn as-drop [(h : I32)] : I32
  (let [k (as-find h)]
    (if (>= k 0) (slot-set (+ 4020 (* k 2)) 0) 0)))

;; 1 if buf has the (all-lowercase, every byte with bit 5 set: letters, '-', ':', ' ') pattern p at i,
;; ignoring ASCII case in buf -- header names are case-insensitive (Alt-Svc / alt-svc)
(defn match-ci-at [(buf : String @ Region) (i : I32) (p : String @ Region)] : I32
  (let [pn (string/length p)]
    (loop [k 0]
      (if (>= k pn)
        1
        (if (= (bit-or (bit-and (string/char-at buf (+ i k)) 255) 32) (string/char-at p k))
          (recur (+ k 1))
          0)))))

;; index just past "lt-svc: " (Alt-Svc / alt-svc) within buf[0..hend), or -1
(defn find-altsvc [(buf : String @ Region) (hend : I32)] : I32
  (loop [i 0]
    (if (> (+ i 8) hend)
      -1
      (if (= (match-ci-at buf i "lt-svc: ") 1) (+ i 8) (recur (+ i 1))))))

(defn digits-at [(buf : String @ Region) (i : I32) (e : I32)] : I32
  (loop [j i v 0]
    (if (>= j e)
      v
      (let [c (string/char-at buf j)]
        (if (and (>= c 48) (<= c 57)) (recur (+ j 1) (+ (* v 10) (- c 48))) v)))))

;; port of the first host-less h3=":NNN" in the header line starting at a; 0 if none
(defn altsvc-h3-port [(buf : String @ Region) (a : I32) (hend : I32)] : I32
  (let [e (loop [k a] (if (>= k hend) hend (if (= (string/char-at buf k) 13) k (recur (+ k 1)))))]
    (loop [i a]
      (if (> (+ i 6) e)
        0
        (if (and (= (match-at buf i "h3=\"") 1) (= (string/char-at buf (+ i 4)) 58))
          (digits-at buf (+ i 5) e)
          (recur (+ i 1)))))))

;; remember that this https origin speaks h3 (only learned from an https response)
(defn note-alt-svc [(buf : String @ Region) (hend : I32) (dest : Arena @ Region)] : I32
  (let [a (find-altsvc buf hend)
        url (cururl-get)]
    (if (or (< a 0) (= (url-https? url) 0))
      0
      (let [port (altsvc-h3-port buf a hend)]
        (if (and (> port 0) (< port 65536))
          (do (as-put (origin-key url dest) port)
              (pg-log-n "alt-svc: h3 port " port dest))
          0)))))

(defn h3-wanted? [(url : String @ Region) (dest : Arena @ Region)] : I32
  (cond
    ((= (slot-get 1095) 1) 0)
    ((= (slot-get 4011) 1) 1)
    ((>= (as-find (origin-key url dest)) 0) 1)
    (true 0)))

(defn h3-teardown [] : I32
  (if (= (slot-get 4010) 1)
    (do (quic-close (quic-static-conn))
        (slot-set 4010 0)
        0)
    0))

(defn h3-abort [] : I32 (h3-teardown))

(defn h3-failed [(st : I32) (dest : Arena @ Region)] : I32
  (do (h3-teardown)
      (pg-log-n "h3 FAILED status=" st dest)
      (as-drop (origin-key (cururl-get) dest))
      (if (= (slot-get 4011) 1)
        (nav-fail (if (= st -3) 9 8) "http/3 failed")
        (do (pg-log "h3: falling back to TCP+TLS")
            (open-conn (cururl-get) dest)))))

(defn h3-armed [(host : String @ Region) (port : I32) (dest : Arena @ Region)] : I32
  (do (slot-set 4010 1)
      (slot-set 6 1)
      (slot-set 2 1)
      (slot-set 4 -1)
      (slot-set 5 -1)
      (pg-log (string/concat "h3: connecting " (string/concat host (string/concat ":" (string/i32-to-string port dest) dest) dest) dest))
      0))

(defn h3-begin [(url : String @ Region) (dest : Arena @ Region)] : I32
  (let [host (url-host url dest)
        k (as-find (origin-key url dest))
        port (if (and (>= k 0) (= (slot-get 4011) 0)) (slot-get (+ 4021 (* k 2))) (url-port url))
        c (quic-connect-static host port 4194304 15000 dest)]
    (if (= (bytes-len c) 0)
      (h3-failed -6 dest)
      (h3-armed host port dest))))

;; one non-blocking step; its own scratch arena so a frame loop never grows the main one
(defn h3-poll [] : I32
  (with-arena [fr :region/scratch 8192]
    (quic-pump (quic-static-conn) (url-host (cururl-get) &mut fr) (url-path (cururl-get) &mut fr))))

(defn h3-done [(dest : Arena @ Region)] : I32
  (let [c (quic-static-conn)
        head (quic-headers-http1 c dest)
        a (stream-append-bytes head 0 (bytes-len head))
        b (stream-append-bytes c (quic-body-off c) (quic-body-len c))]
    (if (or (< a 0) (< b 0))
      (h3-failed -7 dest)
      (do (pg-log-n "h3 ok; bytes=" (+ a b) dest)
          (h3-teardown)
          (slot-set 6 1)
          (slot-set 2 1)
          (slot-set 5 -1)
          (check-headers dest)))))

(defn pump-h3 [(dest : Arena @ Region)] : I32
  (if (= (slot-get 4010) 1)
    (let [st (h3-poll)]
      (cond
        ((= st 0) 0)
        ((= st 1) (h3-done dest))
        (true (h3-failed st dest))))
    0))

(defn nav-dispatch [(url : String @ Region) (dest : Arena @ Region)] : I32
  (cond
    ((= (has-prefix url "https://") 1)
     (if (= (h3-wanted? url dest) 1) (h3-begin url dest) (open-conn url dest)))
    ((= (has-prefix url "http://") 1) (open-conn url dest))
    (true (nav-fail 3 "bad url"))))

(defn close-open-conn [(fd : I32) (dest : Arena @ Region)] : I32
  (do (pg-log-n "navigation closes live stream; fd=" fd dest)
      (stream-close fd)
      (slot-set 4 -1)
      0))

(defn drop-conn [(dest : Arena @ Region)] : I32
  (if (>= (slot-get 4) 0)
    (close-open-conn (slot-get 4) dest)
    0))

(defn md-path? [(s : String @ Region) (e : I32)] : I32
  (cond
    ((and (>= e 3) (= (has-at s (- e 3) e ".md") 1)) 1)
    ((and (>= e 9) (= (has-at s (- e 9) e ".markdown") 1)) 1)
    (true 0)))

(defn url-md? [(url : String @ Region)] : I32
  (if (= (has-prefix url "http") 1)
    (md-path? url (path-end url))
    0))

(defn start-nav [(url : String @ Region) (dest : Arena @ Region)] : I32
  (do
    (drop-conn dest)
    (h3-abort)
    (slot-set 4011 (h3-scheme? url))
    (stream-reset)
    (css-abort)
    (img-reset)
    (slot-set 622 0)
    (cururl-set (nav-url url dest))
    (slot-set 0 0)
    (slot-set 1 0)
    (slot-set 2 1)
    (slot-set 4 -1)
    (slot-set 5 -1)
    (slot-set 12 0)
    (slot-set 26 (url-md? (nav-url url dest)))
    (slot-set 18 -1)
    (slot-set 10 (+ (slot-get 10) 1))
    (slot-set 1088 -1)
    (slot-set 1089 0)
    (slot-set 638 0)
    (slot-set 1096 -1)
    (pg-log (string/concat "navigate " url dest))
    (nav-then url (nav-dispatch (nav-url url dest) dest))))

;; the POST flag lives for one request: redirects (and any failure) go back to GET
(defn nav-then [(url : String @ Region) (r : I32)] : I32
  (do (slot-set 1095 0) r))

;; index just past the first CRLFCRLF in buf[0..len), or -1
(defn find-hdr-end [(buf : String @ Region) (len : I32)] : I32
  (loop [i 0]
    (if (> (+ i 4) len)
      -1
      (if (and (= (string/char-at buf i) 13) (= (string/char-at buf (+ i 1)) 10)
               (= (string/char-at buf (+ i 2)) 13) (= (string/char-at buf (+ i 3)) 10))
        (+ i 4)
        (recur (+ i 1))))))

;; index of the first byte after "ocation: " within buf[0..hend), or -1
(defn find-location [(buf : String @ Region) (hend : I32)] : I32
  (loop [i 0]
    (if (> (+ i 9) hend)
      -1
      (if (= (match-at buf i "ocation: ") 1)
        (+ i 9)
        (recur (+ i 1))))))

(defn status-code [(buf : String @ Region)] : I32
  (+ (+ (* 100 (- (string/char-at buf 9) 48)) (* 10 (- (string/char-at buf 10) 48)))
     (- (string/char-at buf 11) 48)))

(defn scheme-colon [(url : String @ Region)] : String
  (if (= (url-https? url) 1) "https:" "http:"))

(defn absolutize [(loc : String @ Region) (dest : Arena @ Region)] : String
  (cond
    ((= (has-prefix loc "//") 1) (string/concat (scheme-colon (cururl-get)) loc dest))
    ((= (string/char-at loc 0) 47) (string/concat (url-origin (cururl-get) dest) loc dest))
    (true loc)))

;; a redirect inside an h3:// navigation to the SAME origin stays on HTTP/3 (the user asked for it)
(defn h3-keep [(next : String @ Region) (dest : Arena @ Region)] : String
  (if (and (= (slot-get 4011) 1)
           (and (= (has-prefix next "https://") 1)
                (string/str-eq? (url-origin next dest) (url-origin (cururl-get) dest))))
    (string/concat "h3://" (string/substring next 8 (string/length next) dest) dest)
    next))

(defn follow [(next : String @ Region) (dest : Arena @ Region)] : I32
  (do (slot-set 7 (+ (slot-get 7) 1))
      (start-nav (h3-keep next dest) dest))) ; start-nav closes the stream being left

(defn redirect [(buf : String @ Region) (hend : I32) (dest : Arena @ Region)] : I32
  (let [a (find-location buf hend)]
    (if (< a 0)
      0
      (let [e (loop [i a]
                (if (>= i hend)
                  hend
                  (if (= (string/char-at buf i) 13) i (recur (+ i 1)))))
            loc (string/substring buf a e dest)
            next (absolutize loc dest)]
        (if (>= (slot-get 7) 5)
          (nav-fail 4 "too many redirects")
          (follow next dest))))))

(defn on-headers [(hend : I32) (dest : Arena @ Region)] : I32
  (let [buf (stream-buf)
        code (status-code buf)
        lg (pg-log-n "http status=" code dest)
        as (note-alt-svc buf hend dest)]
    (if (and (>= code 301) (<= code 308))
      (redirect buf hend dest)
      0)))

(defn got-headers [(he : I32) (dest : Arena @ Region)] : I32
  (do (slot-set 5 he)
      (slot-set 2 1)
      (on-headers he dest)))

(defn check-headers [(dest : Arena @ Region)] : I32
  (if (>= (slot-get 5) 0)
    0
    (let [he (find-hdr-end (stream-buf) (stream-len))]
      (if (< he 0)
        0
        (got-headers he dest)))))

;; slot 12 = 1: the TLS stream ended without a close_notify (TCP EOF / reset), so the body may be
;; cut short; shown in the status bar and the log rather than passed off as a complete page
(defn note-unclean [] : I32
  (do (slot-set 12 1)
      (pg-log "tls: stream ended WITHOUT close_notify -- page may be truncated")
      0))

(defn close-conn [(fd : I32) (r : I32) (dest : Arena @ Region)] : I32
  (do (stream-close fd)
      (slot-set 4 -1)
      (slot-set 2 1)
      (if (= r -3) (note-unclean) 0)
      (pg-log-n "stream closed; bytes=" (stream-len) dest)
      0))

;; connection ended (EOF or error): look for headers once more, then close if no redirect replaced it
(defn net-eof [(fd : I32) (gen : I32) (r : I32) (dest : Arena @ Region)] : I32
  (let [c (check-headers dest)]
    (if (= (slot-get 10) gen)
      (close-conn fd r dest)
      0)))

(defn mark-dirty-if [(r : I32)] : I32
  (if (> r 0) (slot-set 2 1) 0))

;; pull whatever has landed (a bounded amount per frame so the window stays responsive)
(defn pump-net [(dest : Arena @ Region)] : I32
  (let [fd (slot-get 4)
        gen (slot-get 10)]
    (if (< fd 0)
      0
      (loop [k 0]
        (if (>= k 16)
          (check-headers dest)
          (let [r (stream-pull fd)
                m (mark-dirty-if r)]
            (cond
              ((> r 0) (recur (+ k 1)))
              ((= r 0) (check-headers dest))
              (true (net-eof fd gen r dest)))))))))

(defn cur-page [(page : String @ Region)] : String
  (let [src (slot-get 6)]
    (cond
      ((= src 1) (stream-buf))
      ((= src 3) (error-page (slot-get 8)))
      (true page))))

;; draw-page's end index
(defn cur-end [(page : String @ Region)] : I32
  (let [src (slot-get 6)]
    (cond
      ((= src 1) (stream-len))
      ((= src 3) (string/length (error-page (slot-get 8))))
      (true (slot-get 0)))))

;; first byte to draw: body start once headers are in; nothing while a live stream awaits headers
(defn cur-start [] : I32
  (let [src (slot-get 6)]
    (if (= src 1)
      (if (>= (slot-get 5) 0)
        (slot-get 5)
        (if (>= (slot-get 4) 0) (stream-len) 0))
      0)))

(defn advance [(revealed : I32) (step : I32) (n : I32)] : I32
  (let [r (+ revealed step)]
    (if (>= revealed n) n (if (> r n) n r))))

;; file / embedded page: reveal progressively (the live stream reveals as bytes land)
(defn set-revealed [(v : I32)] : I32
  (do (slot-set 0 v) (slot-set 2 1) 0))

(defn pump-static [(n : I32)] : I32
  (if (= (slot-get 6) 0)
    (let [cur (slot-get 0)
          step (if (> (/ n 120) 48) (/ n 120) 48)
          nxt (advance cur step n)]
      (if (> nxt cur)
        (set-revealed nxt)
        0))
    0))

(defn banner [] : String
  (cond
    ((= (slot-get 12) 1) "PELLEGRINO v1 [https: ended without close_notify, may be truncated]   :=URL  esc=quit   ")
    ((and (= (slot-get 6) 1) (= (url-https? (cururl-get)) 1)) "PELLEGRINO v1 [https]   :=go to URL   esc=quit   ")
    (true "PELLEGRINO v1   :=go to URL   esc=quit   ")))

(defn flags-text [] : String
  (cond
    ((and (= (slot-get 24) 1) (= (slot-get 25) 1)) "css:on md:on   ")
    ((= (slot-get 24) 1) "css:on md:off   ")
    ((= (slot-get 25) 1) "css:off md:on   ")
    (true "css:off md:off   ")))

(defn status-text [(dest : Arena @ Region)] : String
  (if (= (slot-get 3) 1)
    (string/concat (string/concat "> " (linebuf-get) dest) "_" dest)
    (string/concat (string/concat (banner) (flags-text) dest) (cururl-get) dest)))

(defn draw-status [(ren : I32) (win-w : I32) (win-h : I32)] : I32
  (with-arena [fr :region/scratch 4096]
    (draw-str ren (status-text &mut fr) 12 (- win-h 24))))

(defn clear-color [(ren : I32)] : I32
  (if (>= (slot-get 296) 0)
    (set-color ren (slot-get 296))
    (sdl2-raw-set-draw-color ren 18 18 18 255)))

(defn render-frame [(ren : I32) (page : String @ Region) (n : I32) (cols : I32) (rows : I32)
                    (win-w : I32) (win-h : I32)] : I32
  (let [scroll (slot-get 1)
        end (cur-end page)
        rs (reset-sel)
        bg (clear-color ren)
        cl (sdl2-raw-render-clear ren)
        act (slot-set 11 (if (or (>= (slot-get 4) 0) (and (= (slot-get 6) 0) (< (slot-get 0) n))) 1 0))
        last-row (draw-page ren (cur-page page) (cur-start) end scroll cols rows 12 12)
        c1 (sdl2-raw-set-draw-color ren 214 137 16 255)
        hz (if (>= (slot-get 4) 0)
             (sdl2-raw-render-fill-rect ren 0 (+ (+ 12 (* (- last-row scroll) 18)) 20) win-w 2)
             0)
        c2 (sdl2-raw-set-draw-color ren 60 60 60 255)
        ln (sdl2-raw-render-fill-rect ren 0 (- win-h 30) win-w 1)
        c3 (sdl2-raw-set-draw-color ren 166 68 14 255)
        tx (draw-status ren win-w win-h)]
    (do (sdl2-raw-render-present ren) 0)))

;; ---- following links ----
;; first '?' or '#' at/after the host, else the length
(defn path-end [(url : String @ Region)] : I32
  (let [n (string/length url)]
    (loop [i (host-end url)]
      (if (>= i n)
        n
        (let [c (string/char-at url i)]
          (if (or (= c 63) (= c 35)) i (recur (+ i 1))))))))

;; directory of url, with trailing '/': everything up to the last '/' of the path (origin + "/" if none)
(defn url-dir [(url : String @ Region) (dest : Arena @ Region)] : String
  (let [he (host-end url)
        pe (path-end url)
        ls (loop [i (- pe 1)]
             (if (< i he)
               -1
               (if (= (string/char-at url i) 47) i (recur (- i 1)))))]
    (if (< ls 0)
      (string/concat (string/substring url 0 he dest) "/" dest)
      (string/substring url 0 (+ ls 1) dest))))

;; 1 if h is a non-http scheme ("mailto:...", "javascript:...") -- a ':' before any '/', '?' or '#'
(defn other-scheme? [(h : String @ Region)] : I32
  (let [n (string/length h)]
    (loop [i 0]
      (if (>= i n)
        0
        (let [c (string/char-at h i)]
          (cond
            ((= c 58) 1)
            ((or (= c 47) (= c 63) (= c 35)) 0)
            (true (recur (+ i 1)))))))))

;; absolute http(s) URL for an href as written in the page; "" when it is not navigable
(defn resolve-href [(h : String @ Region) (dest : Arena @ Region)] : String
  (cond
    ((= (string/length h) 0) "")
    ((= (string/char-at h 0) 35) "")
    ((= (has-prefix h "https://") 1) h)
    ((= (has-prefix h "http://") 1) h)
    ((= (has-prefix (cururl-get) "http") 0) "")
    ((= (has-prefix h "//") 1) (absolutize h dest))
    ((= (string/char-at h 0) 47) (absolutize h dest))
    ((= (other-scheme? h) 1) "")
    (true (string/concat (url-dir (cururl-get) dest) h dest))))

;; the href text is copied out of the page buffer first: start-nav resets that buffer
(defn go-link [(target : String @ Region) (dest : Arena @ Region)] : I32
  (if (> (string/length target) 0)
    (do (pg-log (string/concat "link click: " target dest))
        (slot-set 7 0)
        (start-nav target dest))
    0))

(defn amp-fix [(s : String @ Region) (dest : Arena @ Region)] : String @ Region
  (let [out (alloc dest String (+ (string/length s) 1))]
    #target
    {:c (inline-c "{ size_t j = 0; for (size_t i = 0; s[i]; ) { if (strncmp(s + i, \"&amp;\", 5) == 0) { out[j++] = '&'; i += 5; } else { out[j++] = s[i++]; } } out[j] = 0; }")}
    out))

(defn follow-link [(page : String @ Region) (dest : Arena @ Region)] : I32
  (let [h (amp-fix (string/substring (cur-page page) (slot-get 15) (slot-get 16) dest) dest)]
    (go-link (resolve-href h dest) dest)))

(defn clear-click [] : I32
  (do (slot-set 13 -1) (slot-set 14 -1) (slot-set 15 -1) (slot-set 16 -1) 0))

;; after a draw pass that followed a Tab: scroll so the selected link's row is on screen
(defn ensure-visible [(rows : I32)] : I32
  (if (and (= (slot-get 23) 1) (>= (slot-get 21) 0))
    (let [r (slot-get 21)
          sc (slot-get 1)
          d (slot-set 23 0)]
      (cond
        ((< r sc) (scroll-to r))
        ((>= r (+ sc rows)) (scroll-to (+ (- r rows) 1)))
        (true 0)))
    0))

;; called right after a frame was drawn: the draw pass filled slots 15/16 if the click landed on a link
(defn resolve-click [(page : String @ Region) (dest : Arena @ Region)] : I32
  (if (>= (slot-get 15) 0)
    (let [r (follow-link page dest)] (clear-click))
    (clear-click)))

(defn on-click [(x : I32) (y : I32)] : I32
  (if (= (slot-get 3) 1)
    0
    (do (slot-set 1088 -1) (slot-set 13 x) (slot-set 14 y) (slot-set 15 -1) (slot-set 2 1) 0)))

;; ---- input ----
(defn go-url [(dest : Arena @ Region)] : I32
  (do (slot-set 3 0)
      (slot-set 7 0)
      (start-nav (linebuf-get) dest)
      0))

(defn type-back [] : I32
  (do (linebuf-backspace) (slot-set 2 1) 0))

(defn leave-typing [] : I32
  (do (slot-set 3 0) (slot-set 2 1) 0))

(defn clamp-scroll [(v : I32)] : I32
  (let [mx (if (> (slot-get 1098) 1) (- (slot-get 1098) 1) 0)]
    (cond
      ((< v 0) 0)
      ((> v mx) mx)
      (true v))))

(defn scroll-to [(v : I32)] : I32
  (do (slot-set 1 (clamp-scroll v)) (slot-set 2 1) 0))

;; last full screen of the page
(defn scroll-end [] : I32
  (scroll-to (- (slot-get 1098) (slot-get 35))))

(defn page-rows [] : I32
  (let [r (- (slot-get 35) 1)]
    (if (< r 1) 1 r)))

(defn on-key-typing [(k : I32) (dest : Arena @ Region)] : I32
  (cond
    ((= k (key-return)) (go-url dest))
    ((= k (key-backspace)) (type-back))
    ((= k 27) (leave-typing))
    (true 0)))

;; 1 = quit
(defn toggle-css [] : I32
  (do (slot-set 24 (- 1 (slot-get 24)))
      (slot-set 2 1)
      (pg-log (if (= (slot-get 24) 1) "css: on" "css: off"))
      0))

(defn toggle-md [] : I32
  (do (slot-set 25 (- 1 (slot-get 25)))
      (slot-set 2 1)
      (pg-log (if (= (slot-get 25) 1) "markdown: on" "markdown: off"))
      0))

(defn select-link [(delta : I32)] : I32
  (let [n (slot-get 22)
        cur (slot-get 18)
        nxt (if (> delta 0)
              (if (>= (+ cur 1) n) 0 (+ cur 1))
              (if (<= cur 0) (- n 1) (- cur 1)))]
    (if (<= n 0)
      0
      (do (slot-set 18 nxt) (slot-set 23 1) (slot-set 2 1) 0))))

;; Enter/Space: follow the selected link exactly as a click on it would (resolve-click picks it up)
(defn activate-link [] : I32
  (if (and (>= (slot-get 18) 0) (>= (slot-get 19) 0))
    (do (slot-set 15 (slot-get 19)) (slot-set 16 (slot-get 20)) 0)
    0))

(defn on-key-view [(k : I32)] : I32
  (cond
    ((and (shift-held?) (= k 106)) (move-win -48 0))
    ((and (shift-held?) (= k 108)) (move-win 48 0))
    ((and (shift-held?) (= k 105)) (move-win 0 -48))
    ((and (shift-held?) (= k 107)) (move-win 0 48))
    ((or (= k 1073741893) (= k 120)) (toggle-css))
    ((or (= k 1073741892) (= k 112)) (toggle-md))
    ((= k 9) (select-link (if (shift-held?) -1 1)))
    ((or (= k (key-return)) (= k 32)) (activate-link))
    ((or (= k 27) (= k 113)) 1)
    ((= k (key-up)) (scroll-to (- (slot-get 1) 1)))
    ((= k (key-down)) (scroll-to (+ (slot-get 1) 1)))
    ((or (= k (key-home)) (= k 1073741898)) (scroll-to 0))
    ((or (= k (key-end)) (= k 1073741901)) (scroll-end))
    ((= k 1073741899) (scroll-to (- (slot-get 1) (page-rows))))
    ((= k 1073741902) (scroll-to (+ (slot-get 1) (page-rows))))
    (true 0)))

(defn on-key [(k : I32) (dest : Arena @ Region)] : I32
  (cond
    ((= (slot-get 3) 1) (on-key-typing k dest))
    ((>= (slot-get 1088) 0) (on-key-field k))
    (true (on-key-view k))))

(defn enter-typing [] : I32
  (do (slot-set 3 1)
      (linebuf-clear)
      (linebuf-append "https://")
      (slot-set 2 1)
      0))

(defn type-text [(t : String @ Region)] : I32
  (do (linebuf-append t) (slot-set 2 1) 0))

(defn on-text [(t : String @ Region)] : I32
  (cond
    ((= (slot-get 3) 1) (type-text t))
    ((>= (slot-get 1088) 0) (fm-type t))
    ((string/str-eq? t ":") (enter-typing))
    (true 0)))

(defn on-wheel [(d : I32)] : I32
  (scroll-to (- (slot-get 1) (* d 3))))

;; drain the event queue; 1 = quit requested
(defn handle-events [(dest : Arena @ Region)] : I32
  (loop [q 0]
    (let [ev (sdl2-raw-poll-event)]
      (cond
        ((= ev 0) 0)
        ((= ev 1) 1)
        ((= ev 2) (if (= (on-key (sdl2-raw-last-event-key) dest) 1) 1 (recur 0)))
        ((= ev 3) (let [x (on-text (sdl2-raw-last-event-text dest))] (recur 0)))
        ((= ev 5) (let [x (on-click (mouse-x) (mouse-y))] (recur 0)))
        ((= ev 9) (let [x (on-wheel (sdl2-raw-last-event-wheel-delta))] (recur 0)))
        (true (recur 0))))))

(defn sdl2_delay_raw [(ms : I32)] : I32
  #target
  {:c (inline-c "(sdl2_delay_impl(ms), 0)")})

(defn redraw [(ren : I32) (page : String @ Region) (n : I32) (cols : I32) (rows : I32)
              (win-w : I32) (win-h : I32)] : I32
  (do (slot-set 2 0)
      (render-frame ren page n cols rows win-w win-h)))

(defn present-or-wait [(ren : I32) (page : String @ Region) (n : I32) (cols : I32) (rows : I32)
                       (win-w : I32) (win-h : I32)] : I32
  (if (= (slot-get 2) 1)
    (redraw ren page n cols rows win-w win-h)
    (sdl2_delay_raw 8)))

;; --smoke-nav=A B: after frame 20 of a self-exiting run, submit B through the same path as typing it in
;; the address bar (B was pre-filled into the line buffer) while A may still be streaming
(defn hop [(dest : Arena @ Region)] : I32
  (do (pg-log "smoke-nav: address-bar navigation")
      (go-url dest)))

(defn smoke-click [] : I32
  (do (pg-log "smoke-click: synthetic click on the first cell")
      (on-click 14 14)))

(defn smoke-key [(d : I32)] : I32
  (do (pg-log (if (> d 0) "smoke-tab: next link" "smoke-tab: previous link"))
      (select-link d)))

(defn smoke-enter [] : I32
  (do (pg-log "smoke-enter: activate selected link")
      (activate-link)))

(defn smoke-scroll [(k : I32) (dest : Arena @ Region)] : I32
  (do (on-key k dest)
      (pg-log-n "smoke-keys: scroll=" (slot-get 1) dest)
      (pg-log-n "smoke-keys: total=" (slot-get 1098) dest)
      0))

(defn smoke-type [] : I32
  (do (pg-log "smoke-form: typing") (fm-type "hello world & co")))

(defn smoke-hop [(frames : I32) (limit : I32) (dest : Arena @ Region)] : I32
  (cond
    ((and (> limit 0) (= frames 30) (= (slot-get 17) 4)) (move-win 48 24))
    ((and (> limit 0) (= frames 60) (= (slot-get 17) 4)) (move-win 48 24))
    ((and (> limit 0) (= frames 40) (= (slot-get 17) 5)) (on-click 20 20))
    ((and (> limit 0) (= frames 60) (= (slot-get 17) 5)) (smoke-type))
    ((and (> limit 0) (= frames 80) (= (slot-get 17) 5)) (on-key (key-return) dest))
    ((and (> limit 0) (= frames 30) (= (slot-get 17) 7)) (smoke-scroll 1073741902 dest))
    ((and (> limit 0) (= frames 40) (= (slot-get 17) 7)) (smoke-scroll 1073741901 dest))
    ((and (> limit 0) (= frames 50) (= (slot-get 17) 7)) (smoke-scroll 1073741899 dest))
    ((and (> limit 0) (= frames 60) (= (slot-get 17) 7)) (smoke-scroll 1073741898 dest))
    ((and (> limit 0) (= frames 20) (> (linebuf-len) 0)) (hop dest))
    ((and (> limit 0) (= frames 60) (= (slot-get 17) 1)) (smoke-click))
    ((and (> limit 0) (= frames 60) (= (slot-get 17) 2)) (smoke-key 1))
    ((and (> limit 0) (= frames 70) (= (slot-get 17) 2)) (smoke-key 1))
    ((and (> limit 0) (= frames 80) (= (slot-get 17) 2)) (smoke-key -1))
    ((and (> limit 0) (= frames 90) (= (slot-get 17) 2)) (smoke-enter))
    ((and (> limit 0) (= frames 40) (= (slot-get 17) 3)) (toggle-css))
    ((and (> limit 0) (= frames 60) (= (slot-get 17) 3)) (toggle-md))
    ((and (> limit 0) (= frames 80) (= (slot-get 17) 3)) (toggle-css))
    (true 0)))

;; ---- <img> fetching: one image per frame, synchronous (bounded), only once the page stream has closed ----
;; DNS/connect/TLS already block the window; an image fetch is the same kind of pause, capped at ~3 s of
;; silence. Bytes land in the stream module's second bank so the page text is never disturbed.
(defn img-request [(host : String @ Region) (port : I32) (path : String @ Region) (url : String @ Region)
                   (dest : Arena @ Region)] : String
  (let [r1 (string/concat "GET " path dest)
        r2 (string/concat r1 " HTTP/1.0\r\nHost: " dest)
        r3 (string/concat r2 (host-header host port url dest) dest)]
    (string/concat r3 "\r\nUser-Agent: PELLEGRINO/v1\r\nAccept: image/png,*/*\r\nConnection: close\r\n\r\n" dest)))

;; pull until the connection ends, the 2 MiB bank is full, or ~3 s pass with no new bytes
(defn img-drain [(fd : I32)] : I32
  (loop [idle 0]
    (if (> idle 600)
      0
      (let [r (stream-pull fd)]
        (cond
          ((> r 0) (recur 0))
          ((= r 0) (let [d (sdl2_delay_raw 5)] (recur (+ idle 1))))
          (true 0))))))

(defn be32 [(data : Bytes) (p : I32)] : I32
  (+ (* (bytes/bytes-get data p) 16777216)
     (+ (* (bytes/bytes-get data (+ p 1)) 65536)
        (+ (* (bytes/bytes-get data (+ p 2)) 256) (bytes/bytes-get data (+ p 3))))))

(defn png-sig? [(data : Bytes)] : Bool
  (and (= (bytes/bytes-get data 0) 137)
       (and (= (bytes/bytes-get data 1) 80)
            (and (= (bytes/bytes-get data 2) 78) (= (bytes/bytes-get data 3) 71)))))

(defn img-decode-ok [(data : Bytes) (w : I32) (h : I32) (dest : Arena @ Region)] : I32
  (let [img (png-decode data dest)]
    (if (= (get-field img :ok) 0)
      -1
      (img-store (get-field img :pixels) w h))))

(defn img-decode-dims [(data : Bytes) (dest : Arena @ Region)] : I32
  (let [w (be32 data 16)
        h (be32 data 20)]
    (if (or (<= w 0) (or (<= h 0) (or (> w 2048) (or (> h 2048) (> (* w h) 262144)))))
      -1
      (img-decode-ok data w h dest))))

(defn img-decode [(he : I32) (dest : Arena @ Region)] : I32
  (let [data (stream-copy-bytes he dest)]
    (if (< (bytes/bytes-len data) 33)
      -1
      (if (png-sig? data) (img-decode-dims data dest) -1))))

(defn img-hop [(url : String @ Region) (hops : I32) (dest : Arena @ Region)] : I32
  (let [host (url-host url dest)
        port (url-port url)
        path (url-path url dest)
        fd (if (= (url-https? url) 1) (stream-connect-tls host port) (stream-connect host port))]
    (if (< fd 0)
      -1
      (let [rs (stream-reset)
            snd (stream-send fd (img-request host port path url dest))
            dr (img-drain fd)
            cl (stream-close fd)]
        (img-parse url hops dest)))))

(defn img-redirect [(buf : String @ Region) (he : I32) (hops : I32) (dest : Arena @ Region)] : I32
  (let [a (find-location buf he)]
    (if (or (< a 0) (>= hops 3))
      -1
      (let [e (loop [i a]
                (if (>= i he)
                  he
                  (if (= (string/char-at buf i) 13) i (recur (+ i 1)))))
            next (absolutize (string/substring buf a e dest) dest)]
        (if (= (has-prefix next "http") 1)
          (img-hop next (+ hops 1) dest)
          -1)))))

(defn img-parse [(url : String @ Region) (hops : I32) (dest : Arena @ Region)] : I32
  (let [buf (stream-buf)
        he (find-hdr-end buf (stream-len))]
    (if (< he 0)
      -1
      (let [code (status-code buf)]
        (cond
          ((and (>= code 301) (<= code 308)) (img-redirect buf he hops dest))
          ((= code 200) (img-decode he dest))
          (true -1))))))

(defn img-src-url [(k : I32) (dest : Arena @ Region)] : String
  (let [pos (slot-get (+ 700 (* k 4)))
        page (stream-buf)
        n (stream-len)
        ns (+ pos 1)
        ne (name-end page ns n)
        te (find-in page 62 ne n)
        s (if (< te 0) -1 (attr-start page ne te "src="))
        e (if (< s 0) -1 (href-end page s te))]
    (if (< e 0)
      ""
      (resolve-href (string/substring page s e dest) dest))))

(defn img-done [(k : I32) (id : I32) (url : String @ Region) (dest : Arena @ Region)] : I32
  (do (slot-set (+ 701 (* k 4)) (if (>= id 0) 1 2))
      (slot-set (+ 702 (* k 4)) id)
      (slot-set 2 1)
      (if (>= id 0)
        (pg-log (string/concat (string/concat "img: loaded " url dest) (string/concat " " (string/i32-to-string (img-w id) dest) dest) dest))
        (pg-log (string/concat "img: failed " url dest)))
      0))

(defn img-load [(k : I32) (dest : Arena @ Region)] : I32
  (let [url (img-src-url k dest)]
    (if (= (string/length url) 0)
      (img-done k -1 "(no usable src)" dest)
      (let [old (stream-bank 1)
            id (img-hop url 0 dest)
            back (stream-bank 0)]
        (img-done k id url dest)))))

(defn img-next [] : I32
  (loop [k 0]
    (if (>= k (slot-get 622))
      -1
      (if (= (slot-get (+ 701 (* k 4))) 0) k (recur (+ k 1))))))

(defn img-pump [] : I32
  (if (and (= (slot-get 6) 1) (and (< (slot-get 4) 0) (and (>= (slot-get 5) 0) (= (css-busy) 0))))
    (let [k (img-next)]
      (if (< k 0)
        0
        (with-arena [fr :region/scratch 65536]
          (img-load k &mut fr))))
    0))

;; ---- external stylesheets: fetched without ever blocking a frame on the body ----
;; <link rel=stylesheet> and @import are found while the page is scanned (see scan-styles) and queued in the sheet
;; table. A sheet is fetched through the stream module's second bank, one non-blocking pull batch per frame; the page
;; keeps painting meanwhile, and when the text lands the whole page is restyled from the first byte: the layout
;; shifts, by design. Plain-http sheets start while the page itself is still streaming; https sheets wait for the
;; page stream to end (the TLS client holds one session). Connect/handshake still block, same as <img>.
;; Slots: 1640 sheet count, 1641 sheet being fetched (-1 none), 1642 its stream handle, 1643 idle frames,
;; 1646/1647 viewport width/height, 1634 % base px (16), 1632/1633 calc end/position, 1740 custom property count.
(defn css-request [(host : String @ Region) (port : I32) (path : String @ Region) (url : String @ Region)
                   (dest : Arena @ Region)] : String
  (let [r1 (string/concat "GET " path dest)
        r2 (string/concat r1 " HTTP/1.0\r\nHost: " dest)
        r3 (string/concat r2 (host-header host port url dest) dest)]
    (string/concat r3 "\r\nUser-Agent: PELLEGRINO/v1\r\nAccept: text/css,*/*;q=0.1\r\nConnection: close\r\n\r\n" dest)))

;; a url found in a stylesheet resolves against that sheet's own address
(defn resolve-from [(base : String @ Region) (h : String @ Region) (dest : Arena @ Region)] : String
  (cond
    ((= (string/length h) 0) "")
    ((= (has-prefix h "https://") 1) h)
    ((= (has-prefix h "http://") 1) h)
    ((= (has-prefix h "//") 1) (string/concat (scheme-colon base) h dest))
    ((= (string/char-at h 0) 47) (string/concat (url-origin base dest) h dest))
    ((= (other-scheme? h) 1) "")
    (true (string/concat (url-dir base dest) h dest))))

(defn sheet-url [(k : I32) (page : String @ Region) (dest : Arena @ Region)] : String
  (let [t (if (= (sh-get k 6) 1) (css-buf) page)
        h (amp-fix (string/substring t (sh-get k 7) (sh-get k 8) dest) dest)
        par (sh-get k 4)]
    (if (< par 0)
      (resolve-href h dest)
      (resolve-from (sheet-url par page dest) h dest))))

(defn css-log [(what : String @ Region) (url : String @ Region) (dest : Arena @ Region)] : I32
  (pg-log (string/concat what url dest)))

(defn css-fail [(k : I32) (url : String @ Region) (dest : Arena @ Region)] : I32
  (do (sh-set k 1 3)
      (slot-set 1641 -1)
      (css-log "css: failed " url dest)
      0))

;; connect, send the request; bank 1 must already be selected
(defn css-open [(k : I32) (url : String @ Region) (dest : Arena @ Region)] : I32
  (let [host (url-host url dest)
        port (url-port url)
        path (url-path url dest)
        fd (if (= (url-https? url) 1) (stream-connect-tls host port) (stream-connect host port))]
    (if (< fd 0)
      (css-fail k url dest)
      (let [rs (stream-reset)
            snd (stream-send fd (css-request host port path url dest))]
        (do (sh-set k 1 1)
            (slot-set 1641 k)
            (slot-set 1642 fd)
            (slot-set 1643 0)
            (css-log "css: fetch " url dest)
            0)))))

(defn css-next [] : I32
  (loop [k 0]
    (if (>= k (slot-get 1640))
      -1
      (if (= (sh-get k 1) 0) k (recur (+ k 1))))))

(defn css-begin [(page : String @ Region) (dest : Arena @ Region)] : I32
  (let [k (css-next)]
    (if (< k 0)
      0
      (let [url (sheet-url k page dest)]
        (cond
          ((= (string/length url) 0) (css-fail k "(no usable href)" dest))
          ((and (>= (slot-get 4) 0) (= (url-https? url) 1)) 0)
          (true (css-open k url dest)))))))

;; pulls until nothing more has landed: 1 data keeps coming, 0 nothing yet, -1 the stream ended
(defn css-pull [(fd : I32)] : I32
  (loop [n 0]
    (if (>= n 16)
      1
      (let [r (stream-pull fd)]
        (cond
          ((> r 0) (recur (+ n 1)))
          ((= r 0) (if (> n 0) 1 0))
          (true -1))))))

(defn css-done [(k : I32) (he : I32) (url : String @ Region) (dest : Arena @ Region)] : I32
  (let [st (css-append he 98304)]
    (if (< st 0)
      (css-fail k url dest)
      (do (sh-set k 1 2)
          (sh-set k 2 st)
          (sh-set k 3 (- (css-len) 1))
          (slot-set 1641 -1)
          (slot-set 2 1)
          (css-log (string/concat "css: loaded " (string/concat (string/i32-to-string (- (css-len) (+ st 1)) dest) " bytes " dest) dest) url dest)
          0))))

(defn css-redirect [(k : I32) (buf : String @ Region) (he : I32) (url : String @ Region) (dest : Arena @ Region)] : I32
  (let [a (find-location buf he)]
    (if (or (< a 0) (>= (sh-get k 9) 3))
      (css-fail k url dest)
      (let [e (loop [i a]
                (if (>= i he)
                  he
                  (if (= (string/char-at buf i) 13) i (recur (+ i 1)))))
            next (absolutize (string/substring buf a e dest) dest)]
        (if (= (has-prefix next "http") 1)
          (do (sh-set k 9 (+ (sh-get k 9) 1))
              (css-open k next dest))
          (css-fail k url dest))))))

(defn css-parse [(k : I32) (url : String @ Region) (dest : Arena @ Region)] : I32
  (let [buf (stream-buf)
        he (find-hdr-end buf (stream-len))]
    (if (< he 0)
      (css-fail k url dest)
      (let [code (status-code buf)]
        (cond
          ((and (>= code 301) (<= code 308)) (css-redirect k buf he url dest))
          ((= code 200) (css-done k he url dest))
          (true (css-fail k url dest)))))))

(defn css-finish [(page : String @ Region) (dest : Arena @ Region)] : I32
  (let [k (slot-get 1641)
        fd (slot-get 1642)
        cl (stream-close fd)
        url (sheet-url k page dest)]
    (css-parse k url dest)))

(defn css-receive [(page : String @ Region) (dest : Arena @ Region)] : I32
  (let [r (css-pull (slot-get 1642))
        idle (if (= r 0) (+ (slot-get 1643) 1) 0)
        sv (slot-set 1643 idle)]
    (cond
      ((< r 0) (css-finish page dest))
      ((> idle 700) (css-finish page dest))
      (true 0))))

(defn css-busy [] : I32
  (if (>= (slot-get 1641) 0) 1 (if (>= (css-next) 0) 1 0)))

;; once per frame: start the next queued sheet, or move the one in flight along
(defn css-pump [(page : String @ Region)] : I32
  (if (= (css-busy) 0)
    0
    (with-arena [fr :region/scratch 16384]
      (let [p (cur-page page)
            old (stream-bank 1)
            r (if (< (slot-get 1641) 0) (css-begin p &mut fr) (css-receive p &mut fr))
            back (stream-bank old)]
        r))))

;; leaving the page: drop a fetch in flight and forget every sheet and custom property
(defn css-abort [] : I32
  (let [k (slot-get 1641)
        old (stream-bank 1)
        cl (if (>= k 0) (stream-close (slot-get 1642)) 0)
        back (stream-bank old)]
    (do (slot-set 1641 -1)
        (slot-set 1640 0)
        (slot-set 1740 0)
        (css-reset)
        0)))


;; ---- form submission: GET appends ?name=value&..., POST sends the same urlencoded body ----
;; The encoded pairs are built in the line buffer (1023 bytes max: a bigger form is refused, not truncated).
(defn lb-clear [] : I32
  (do (linebuf-clear) 0))

(defn lb-add [(s : String @ Region)] : I32
  (do (linebuf-append s) 0))

(defn hex-ch [(n : I32)] : I32
  (if (< n 10) (+ 48 n) (+ 55 n)))

(defn fm-enc-ch [(c : I32) (dest : Arena @ Region)] : I32
  (cond
    ((or (letter? c) (or (digit? c) (or (= c 45) (or (= c 46) (or (= c 95) (= c 126))))))
     (lb-add (string/char-from-code c dest)))
    ((= c 32) (lb-add "+"))
    (true (let [a (lb-add "%")
                b (lb-add (string/char-from-code (hex-ch (/ c 16)) dest))]
            (lb-add (string/char-from-code (hex-ch (mod c 16)) dest))))))

(defn fm-ent-code [(p : String @ Region) (i : I32) (e : I32)] : I32
  (if (= (string/char-at p i) 38)
    (let [pk (amp-ent p i e)]
      (if (and (> pk 0) (< (mod pk 4096) 128)) pk 0))
    0))

;; an attribute value as sent: &amp; &quot; &#39; ... are decoded first
(defn fm-enc-page [(p : String @ Region) (s : I32) (e : I32) (dest : Arena @ Region)] : I32
  (loop [i s]
    (if (>= i e)
      0
      (let [pk (fm-ent-code p i e)
            x (fm-enc-ch (if (> pk 0) (mod pk 4096) (string/char-at p i)) dest)]
        (recur (+ i (if (> pk 0) (/ pk 4096) 1)))))))

(defn fm-enc-store [(j : I32) (dest : Arena @ Region)] : I32
  (loop [i 0]
    (if (>= i (fm-get j 1))
      0
      (let [x (fm-enc-ch (fm-ch j i) dest)] (recur (+ i 1))))))

(defn fm-enc-sel [(p : String @ Region) (j : I32) (n : I32) (te : I32) (dest : Arena @ Region)] : I32
  (let [lim (sel-lim p te n)
        cnt (opt-nth p te lim -1)
        i0 (fm-get j 2)
        o (opt-nth p te lim (if (>= i0 cnt) 0 i0))
        gt (if (< o 0) -1 (find-in p 62 o lim))
        vs (if (>= gt 0) (attr-start p (+ o 7) gt "value=") -1)
        ve (if (< vs 0) -1 (href-end p vs gt))]
    (cond
      ((< gt 0) 0)
      ((>= ve 0) (fm-enc-page p vs ve dest))
      (true (fm-enc-page p (+ gt 1) (opt-label-end p (+ gt 1) lim) dest)))))

(defn fm-enc-value [(p : String @ Region) (j : I32) (kind : I32) (n : I32) (ne : I32) (te : I32) (dest : Arena @ Region)] : I32
  (if (or (= kind 1) (= kind 2))
    (fm-enc-store j dest)
    (if (= kind 7)
      (fm-enc-sel p j n te dest)
    (let [vs (attr-start p ne te "value=")
          ve (if (< vs 0) -1 (href-end p vs te))]
      (if (< ve 0)
        (if (or (= kind 4) (= kind 5)) (lb-add "on") 0)
        (fm-enc-page p vs ve dest))))))

(defn fm-append-pair [(p : String @ Region) (j : I32) (kind : I32) (n : I32) (ns : I32) (nee : I32) (ne : I32) (te : I32)
                      (dest : Arena @ Region)] : I32
  (let [sp (if (> (linebuf-len) 0) (lb-add "&") 0)
        a (fm-enc-page p ns nee dest)
        b (lb-add "=")]
    (fm-enc-value p j kind n ne te dest)))

(defn fm-include [(j : I32) (trig : I32) (kind : I32) (nee : I32)] : I32
  (cond
    ((< nee 0) 0)
    ((= kind 6) (if (= j trig) 1 0))
    ((or (= kind 4) (= kind 5)) (fm-get j 2))
    (true 1)))

(defn fm-pair [(p : String @ Region) (n : I32) (j : I32) (trig : I32) (dest : Arena @ Region)] : I32
  (let [pos (fm-get j 0)
        te (find-in p 62 pos n)
        ne (if (< te 0) -1 (name-end p (+ pos 1) te))
        ns (if (< ne 0) -1 (attr-start p ne te "name="))
        nee (if (< ns 0) -1 (href-end p ns te))
        kind (fm-get j 4)]
    (if (= (fm-include j trig kind nee) 1)
      (fm-append-pair p j kind n ns nee ne te dest)
      0)))

(defn fm-collect [(p : String @ Region) (n : I32) (fpos : I32) (trig : I32) (dest : Arena @ Region)] : I32
  (loop [j 0]
    (if (>= j (slot-get 1089))
      0
      (let [x (if (= (fm-get j 3) fpos) (fm-pair p n j trig dest) 0)]
        (recur (+ j 1))))))

(defn self-url [(dest : Arena @ Region)] : String
  (string/substring (cururl-get) 0 (path-end (cururl-get)) dest))

(defn fm-go-get [(base : String @ Region) (dest : Arena @ Region)] : I32
  (let [sep (if (>= (find-char base 63 0) 0) "&" "?")
        u (string/concat (string/concat base sep dest) (linebuf-get) dest)]
    (go-link u dest)))

(defn fm-go-post [(base : String @ Region) (dest : Arena @ Region)] : I32
  (do (pg-log (string/concat "form: POST " base dest))
      (slot-set 1095 1)
      (go-link base dest)))

(defn fm-send [(p : String @ Region) (n : I32) (fpos : I32) (k : I32) (base : String @ Region) (post : I32)
               (dest : Arena @ Region)] : I32
  (let [c (lb-clear)
        x (fm-collect p n fpos k dest)]
    (cond
      ((> (linebuf-len) 1000) (do (pg-log "form: too large to send (limit ~1000 bytes encoded)") 0))
      ((= post 1) (fm-go-post base dest))
      (true (fm-go-get base dest)))))

(defn fm-go [(p : String @ Region) (n : I32) (fpos : I32) (te : I32) (k : I32) (dest : Arena @ Region)] : I32
  (let [ne (name-end p (+ fpos 1) te)
        as (attr-start p ne te "action=")
        ae (if (< as 0) -1 (href-end p as te))
        ms (attr-start p ne te "method=")
        post (if (< ms 0) 0 (if (or (= (string/char-at p ms) 112) (= (string/char-at p ms) 80)) 1 0))
        act (if (>= ae 0) (resolve-href (amp-fix (string/substring p as ae dest) dest) dest) "")
        base (if (> (string/length act) 0) act (self-url dest))]
    (if (= (has-prefix base "http") 0)
      (do (pg-log "form: no http(s) target, nothing sent") 0)
      (fm-send p n fpos k base post dest))))

(defn fm-run [(page : String @ Region) (k : I32) (dest : Arena @ Region)] : I32
  (let [p (cur-page page)
        n (cur-end page)
        fpos (fm-get k 3)
        te (if (< fpos 0) -1 (find-in p 62 fpos n))]
    (if (< te 0)
      (do (pg-log "form: control is not inside a <form>") 0)
      (fm-go p n fpos te k dest))))

(defn fm-submit [(page : String @ Region)] : I32
  (let [k (slot-get 1096)
        d (slot-set 1096 -1)]
    (if (< k 0)
      0
      (with-arena [fr :region/scratch 65536]
        (fm-run page k &mut fr)))))

;; typed text (SDL text input) and keys while a field has focus
(defn fm-append [(k : I32) (c : I32)] : I32
  (let [n (fm-get k 1)]
    (if (and (>= c 32) (and (< c 127) (< n 32)))
      (do (fm-put k n c) (fm-set k 1 (+ n 1)) (slot-set 2 1) 0)
      0)))

(defn fm-type [(t : String @ Region)] : I32
  (let [k (slot-get 1088)
        n (string/length t)]
    (loop [i 0]
      (if (>= i n)
        0
        (let [x (fm-append k (string/char-at t i))] (recur (+ i 1)))))))

(defn fm-back [] : I32
  (let [k (slot-get 1088)
        n (fm-get k 1)]
    (if (> n 0) (do (fm-set k 1 (- n 1)) (slot-set 2 1) 0) 0)))

(defn fm-unfocus [] : I32
  (do (slot-set 1088 -1) (slot-set 2 1) 0))

(defn on-key-field [(k : I32)] : I32
  (cond
    ((= k (key-return)) (do (slot-set 1096 (slot-get 1088)) 0))
    ((= k (key-backspace)) (fm-back))
    ((or (= k 27) (= k 9)) (fm-unfocus))
    (true 0)))

(defn move-win [(dx : I32) (dy : I32)] : I32
  (do (pg-log "window: move")
      (sdl2-raw-move-window (slot-get 1097) dx dy)
      0))

(defn frame-loop [(ren : I32) (page : String @ Region) (n : I32) (win-w : I32) (win-h : I32)
                  (limit : I32) (dest : Arena @ Region)] : I32
  (let [cols (/ (- win-w 24) 12)
        rows (/ (- win-h 52) 18)]
    (loop [frames 0]
      (if (and (> limit 0) (>= frames limit))
        (do (pg-log-n "smoke limit reached; frames=" frames dest) frames)
        (if (= (handle-events dest) 1)
          (do (pg-log-n "quit; frames=" frames dest) frames)
          (let [p0 (smoke-hop frames limit dest)
                ph (pump-h3 dest)
                p1 (pump-net dest)
                pc (css-pump page)
                pi (img-pump)
                p2 (pump-static n)
                p3 (present-or-wait ren page n cols rows win-w win-h)
                p4 (resolve-click page dest)
                p5 (ensure-visible rows)
                p6 (fm-submit page)]
            (recur (+ frames 1))))))))

;; ---- embed API (v1.11, 2026-10-15): PELLEGRINO as a library inside a host that owns the window ----
;; SHANKPIT's lobby draws its OS menu (HTML + CSS) through the same layout/paint engine the browser uses.
;; The host owns the SDL window, renderer, event loop and present; none of that is touched here. It hands
;; over a page string, mouse/key events, and reads back which link was activated as a (start,end) byte
;; range INTO ITS OWN page string (no copy, no network: embed mode never navigates). Slot map:
;;   4000 embed flag   4001/4002 activated href range (-1 = none until the host calls embed-ack)
(defn embed-init [(w : I32) (h : I32)] : I32
  (do (slot-set 4000 1)
      (slot-set 4001 -1)
      (slot-set 4002 -1)
      (slot-set 0 0)
      (slot-set 1 0)
      (slot-set 2 1)
      (slot-set 3 0)
      (slot-set 4 -1)
      (slot-set 5 -1)
      (slot-set 6 0)
      (slot-set 24 1)
      (slot-set 25 1)
      (slot-set 296 -1)
      (slot-set 1641 -1)
      (slot-set 1640 0)
      (slot-set 1646 w)
      (slot-set 1647 h)
      (slot-set 1634 16)
      (slot-set 298 -1)
      (slot-set 26 0)
      (slot-set 1097 -1)
      (slot-set 1088 -1)
      (slot-set 1096 -1)
      (slot-set 1091 -1)
      (slot-set 1094 -1)
      (slot-set 18 -1)
      (slot-set 22 0)
      (slot-set 23 0)
      (clear-click)
      (reset-sel)
      0))

(defn embed-open [(w : I32) (h : I32)] : I32
  (do (embed-init w h)
      (sdl2-raw-create-surface-renderer w h)))

(defn embed-resolve [] : I32
  (if (>= (slot-get 15) 0)
    (do (slot-set 4001 (slot-get 15)) (slot-set 4002 (slot-get 16)) (clear-click))
    (clear-click)))

;; one frame of `page` (n bytes) into the host's renderer at (12,12); never presents. clear=1 clears first.
(defn embed-draw [(ren : I32) (page : String @ Region) (n : I32) (w : I32) (h : I32) (clear : I32)] : I32
  (let [s (set-revealed n)
        cb (if (= clear 1) (clear-color ren) 0)
        cl (if (= clear 1) (sdl2-raw-render-clear ren) 0)
        rs (reset-sel)
        cols (/ (- w 24) 12)
        rows (/ (- h 24) 18)
        last (draw-page ren page 0 n (slot-get 1) cols rows 12 12)
        r (embed-resolve)]
    last))

(defn embed-click [(x : I32) (y : I32)] : I32
  (on-click x y))

(defn embed-wheel [(d : I32)] : I32
  (on-wheel d))

;; Tab / Shift+Tab select a link, Enter / Space activate it; every other key is the host's business
(defn embed-key [(k : I32)] : I32
  (cond
    ((= k 9) (select-link (if (shift-held?) -1 1)))
    ((or (= k (key-return)) (= k 32)) (activate-link))
    (true 0)))

(defn embed-action-start [] : I32
  (slot-get 4001))

(defn embed-action-end [] : I32
  (slot-get 4002))

(defn embed-ack [] : I32
  (do (slot-set 4001 -1) (slot-set 4002 -1) 0))

(defn pellegrino-run [(arg : String @ Region)] : I32
  (with-arena [a :region/scratch 65536]
    (do
      (pg-log "pellegrino v1 start")
      (let [smoke (string/str-eq? arg "--smoke")
            surl (has-prefix arg "--smoke-url=")
            snav (has-prefix arg "--smoke-nav=")
            sclk (has-prefix arg "--smoke-click=")
            stab (has-prefix arg "--smoke-tab=")
            stog (has-prefix arg "--smoke-toggle=")
            smv (has-prefix arg "--smoke-move=")
            sfm (has-prefix arg "--smoke-form=")
            sky (has-prefix arg "--smoke-keys=")
            sx (if (or (= smv 1) (or (= sfm 1) (= sky 1))) 1 0)
            sp (if (= snav 1) (find-char arg 32 12) -1)
            url (cond
                  ((= surl 1) (string/substring arg 12 (string/length arg) &mut a))
                  ((= sclk 1) (string/substring arg 14 (string/length arg) &mut a))
                  ((= stab 1) (string/substring arg 12 (string/length arg) &mut a))
                  ((= stog 1) (string/substring arg 15 (string/length arg) &mut a))
                  ((= sx 1) (string/substring arg 13 (string/length arg) &mut a))
                  ((and (= snav 1) (> sp 0)) (string/substring arg 12 sp &mut a))
                  (true arg))
            pre (if (and (= snav 1) (> sp 0))
                  (linebuf-append (string/substring arg (+ sp 1) (string/length arg) &mut a))
                  0)
            isurl (if (= (has-prefix url "h3://") 1) 1 (has-prefix url "http"))
            fd (if (and (> (string/length url) 0) (not smoke) (= isurl 0)) (raw-open url 0) -1)
            page (if (>= fd 0) (raw-read-all fd &mut a) (embedded-page))
            n (string/length page)]
        (do
          (pg-log-n "source bytes=" n &mut a)
          (slot-set 2 1)
          (slot-set 4 -1)
          (slot-set 5 -1)
          (if (< (sdl2-raw-init) 0)
            (do (pg-log "SDL init FAILED") 1)
            (let [win (sdl2-raw-create-window-borderless "PELLEGRINO" 1280 720)]
              (if (< win 0)
                (do (pg-log "window create FAILED") 2)
                (let [ren (sdl2-raw-create-renderer win)]
                  (if (< ren 0)
                    (do (pg-log "renderer create FAILED") 3)
                    (do (pg-log "window+renderer up (borderless 1280x720)")
                        (start-text-input)
                        (slot-set 24 1)
                        (slot-set 25 1)
                        (slot-set 296 -1)
                        (slot-set 1641 -1)
                        (slot-set 1640 0)
                        (slot-set 1646 1280)
                        (slot-set 1647 720)
                        (slot-set 1634 16)
                        (slot-set 298 -1)
                        (slot-set 26 (if (= isurl 1) 0 (md-path? url (string/length url))))
                        (slot-set 17 (if (= smv 1) 4 (if (= sfm 1) 5 (if (= sky 1) 7 (if (= stog 1) 3 (if (= stab 1) 2 sclk))))))
                        (slot-set 1097 win)
                        (slot-set 1088 -1)
                        (slot-set 1096 -1)
                        (slot-set 1091 -1)
                        (slot-set 1094 -1)
                        (clear-click)
                        (if (= isurl 1) (start-nav url &mut a) 0)
                        (frame-loop ren page n 1280 720 (if (= sx 1) 400 (if (or smoke (= surl 1) (= snav 1) (= sclk 1) (= stab 1) (= stog 1)) 120 0)) &mut a)
                        (sdl2-raw-destroy-renderer ren)
                        (sdl2-raw-destroy-window win)
                        (pg-log "clean exit")
                        0)))))))))))
