(defn ua-block? [(ua : I32)] : I32
  (if (or (and (>= ua 1) (<= ua 9)) (or (= ua 16) (= ua 17) (= ua 18) (= ua 20) (and (>= ua 25) (<= ua 27)))) 1 0))

(defn void-tag? [(page : String @ Region) (a : I32) (b : I32)] : I32
  (cond
    ((= (word-eq page a b "br") 1) 1)
    ((= (word-eq page a b "hr") 1) 1)
    ((= (word-eq page a b "img") 1) 1)
    ((= (word-eq page a b "meta") 1) 1)
    ((= (word-eq page a b "link") 1) 1)
    ((= (word-eq page a b "input") 1) 1)
    ((= (word-eq page a b "base") 1) 1)
    ((= (word-eq page a b "wbr") 1) 1)
    ((= (word-eq page a b "area") 1) 1)
    ((= (word-eq page a b "source") 1) 1)
    ((= (word-eq page a b "track") 1) 1)
    ((= (word-eq page a b "param") 1) 1)
    ((= (word-eq page a b "embed") 1) 1)
    ((= (word-eq page a b "col") 1) 1)
    (true 0)))

;; tag at page[lt..gt]: -1 closer, +1 opener that needs a closer, 0 comment/void/self-closing
(defn fx-delta [(page : String @ Region) (lt : I32) (gt : I32)] : I32
  (let [c1 (string/char-at page (+ lt 1))
        ne (name-end page (+ lt 1) gt)]
    (cond
      ((= c1 47) -1)
      ((not (letter? c1)) 0)
      ((= (string/char-at page (- gt 1)) 47) 0)
      ((= (void-tag? page (+ lt 1) ne) 1) 0)
      (true 1))))

(defn fx-blk [(page : String @ Region) (lt : I32) (gt : I32)] : I32
  (ua-block? (ua-id page (+ lt 1) (name-end page (+ lt 1) gt))))

;; block-level direct children of the element whose tag ends at `from`, among the bytes revealed so far
(defn flex-count [(page : String @ Region) (from : I32) (rev : I32)] : I32
  (loop [k from depth 0 n 0]
    (let [lt (find-in page 60 k rev)
          gt (if (< lt 0) -1 (find-in page 62 lt rev))]
      (if (< gt 0)
        n
        (let [dl (fx-delta page lt gt)]
          (cond
            ((and (< dl 0) (= depth 0)) n)
            ((< dl 0) (recur (+ gt 1) (- depth 1) n))
            ((> dl 0) (recur (+ gt 1) (+ depth 1) (+ n (if (and (= depth 0) (= (fx-blk page lt gt) 1)) 1 0))))
            (true (recur (+ gt 1) depth n))))))))

;; default vertical margins (rows of 18px; 1 row ~ 1em). Adjacent margins collapse (margin-rows), so a UA margin
;; of 1 on both sides of a paragraph is one blank row between paragraphs, like a browser's 1em.
(defn ua-v [(mt : I32) (mb : I32)] : I32
  (do (tset 12 mt) (tset 14 mb) 0))

(defn ua-h [(scale : I32) (bold : I32) (fg : I32) (mb : I32)] : I32
  (do (tset 3 scale) (tset 4 bold) (tset 1 fg) (ua-v 1 1)))

;; ul/ol/menu: 1em above and below, none when nested inside an li; slot 1655 = hash of "li" (set when one opens)
(defn li-open [] : I32
  (loop [d (- (slot-get 31) 1)]
    (if (< d 1)
      0
      (if (= (eget d 0) (slot-get 1655)) 1 (recur (- d 1))))))

(defn ua-list [] : I32
  (do (tset 15 36) (if (= (li-open) 1) (ua-v 0 0) (ua-v 1 1))))

(defn ua-code [] : I32
  (do (tset 1 11075486) (tset 2 2500134) 0))

(defn ua-pre [] : I32
  (do (ua-v 1 1) (tset 1 11075486) (tset 2 2105376) (tset 16 1) (tset 18 1) (tset 19 8) (tset 17 8) 0))

(defn ua-quote [] : I32
  (do (ua-v 1 1) (tset 1 11579568) (tset 8 2) (tset 9 6316128) (tset 22 1) (tset 15 12) (tset 19 8) 0))

(defn ua-mark [] : I32
  (do (tset 1 0) (tset 2 16769126) 0))

(defn ua-style [(ua : I32)] : I32
  (cond
    ((= ua 1) (ua-h 4 1 16777215 1))
    ((= ua 2) (ua-h 3 1 16771496 1))
    ((= ua 3) (ua-h 2 1 12572671 0))
    ((= ua 4) (ua-h 2 0 14737632 0))
    ((= ua 5) (ua-h 2 0 10133670 0))
    ((= ua 6) (ua-h 1 0 10133670 0))
    ((= ua 9) (tset 15 24))
    ((= ua 10) (tset 4 1))
    ((= ua 11) (ua-code))
    ((= ua 12) (tset 1 16771496))
    ((= ua 13) (tset 3 1))
    ((= ua 14) (tset 3 3))
    ((= ua 15) (ua-mark))
    ((= ua 16) (ua-pre))
    ((= ua 17) (ua-quote))
    ((= ua 7) (ua-v 1 1))
    ((= ua 20) (ua-list))
    ((= ua 25) (ua-v 1 1))
    ((= ua 26) (tset 15 36))
    ((= ua 27) (do (ua-v 1 1) (tset 15 36) (tset 13 36)))
    ((= ua 21) (tset 10 1))
    ((= ua 23) (do (tset 1 8421504) (deco-mark 21)))
    ((= ua 24) (deco-mark 20))
    (true 0)))

;; ---- author CSS ----
(defn set-fg [(c : I32)] : I32
  (if (>= c 0) (do (xset (slot-get 31) 9 1) (tset 1 c)) 0))

(defn set-bg [(c : I32)] : I32
  (if (>= c 0) (tset 2 c) 0))

(defn set-size [(px : I32)] : I32
  (cond
    ((< px 0) 0)
    ((<= px 11) (tset 3 1))
    ((<= px 19) (tset 3 2))
    ((<= px 27) (tset 3 3))
    (true (tset 3 4))))

(defn set-weight [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (let [a (skip-ws page vs ve)
        b (tok-end page a ve)]
    (cond
      ((= (word-eq page a b "bold") 1) (tset 4 1))
      ((= (word-eq page a b "bolder") 1) (tset 4 1))
      ((= (word-eq page a b "normal") 1) (tset 4 0))
      ((and (= (- b a) 3) (>= (string/char-at page a) 54) (<= (string/char-at page a) 57)) (tset 4 1))
      (true (tset 4 0)))))

(defn flex-claim [(page : String @ Region)] : I32
  (if (= (slot-get 610) 0)
    (do (tset 11 1)
        (slot-set 610 (slot-get 31))
        (slot-set 613 0)
        (slot-set 616 0)
        (slot-set 614 0)
        (slot-set 611 (flex-count page (+ (slot-get 618) 1) (slot-get 617)))
        0)
    (tset 11 1)))

(defn flex-dir [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (if (and (= (slot-get 610) (slot-get 31)) (= (has-tok page vs ve "column") 1))
    (do (slot-set 610 0) 0)
    0))

(defn set-gap [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (let [v (parse-len page vs ve)]
    (if (< v 0)
      0
      (do (slot-set 619 v) (slot-set 620 (slot-get 31)) 0))))

(defn set-display [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (let [a (skip-ws page vs ve)
        b (tok-end page a ve)]
    (cond
      ((= (word-eq page a b "none") 1) (tset 10 1))
      ((= (word-eq page a b "block") 1) (tset 11 1))
      ((= (word-eq page a b "list-item") 1) (tset 11 1))
      ((= (word-eq page a b "inline") 1) (tset 11 0))
      ((= (word-eq page a b "inline-block") 1) (tset 11 0))
      ((= (word-eq page a b "flex") 1) (flex-claim page))
      ((= (word-eq page a b "inline-flex") 1) (flex-claim page))
      (true 0))))

(defn rows-m [(px : I32)] : I32
  (if (>= px 100000) 0 (rows-of px)))

;; width value -> px; a % is of the parent's content width pw; -1 when auto / not a length
(defn parse-width [(page : String @ Region) (vs : I32) (ve : I32) (pw : I32)] : I32
  (let [s (skip-ws page vs ve)
        e (trim-end page s ve)]
    (cond
      ((>= s e) -1)
      ((= (has-at page s e "calc(") 1) (calc-eval page s e pw))
      ((not (digit? (string/char-at page s))) -1)
      ((>= (find-in page 37 s e) 0) (/ (* (scan-int page s e) pw) 100))
      (true (len-num page s e)))))

;; width (mode 0) / max-width (mode 1): content-box px, stored in field 20
(defn set-width [(page : String @ Region) (vs : I32) (ve : I32) (mode : I32)] : I32
  (let [v (parse-width page vs ve (- (tget 23) (tget 5)))
        cur (tget 20)]
    (cond
      ((< v 0) 0)
      ((= mode 0) (tset 20 v))
      ((or (< cur 0) (> cur v)) (tset 20 v))
      (true 0))))

;; margin / padding shorthand: base 12 (margin) or 16 (padding); order is top right bottom left
(defn box-set [(base : I32)] : I32
  (let [n (slot-get 608)
        v0 (slot-get 604)
        v1 (slot-get 605)
        v2 (slot-get 606)
        v3 (slot-get 607)
        r0 (if (>= n 2) v1 v0)
        b0 (if (>= n 3) v2 v0)
        l0 (if (>= n 4) v3 (if (>= n 2) v1 v0))
        r (if (and (>= r0 100000) (= base 16)) 0 r0)
        l (if (and (>= l0 100000) (= base 16)) 0 l0)]
    (if (<= n 0)
      0
      (do (tset base (rows-m v0))
          (tset (+ base 1) r)
          (tset (+ base 2) (rows-m b0))
          (tset (+ base 3) l)
          0))))

(defn box-lens [(page : String @ Region) (vs : I32) (ve : I32) (base : I32)] : I32
  (let [n (parse-lens page vs ve)]
    (box-set base)))

(defn side-set [(field : I32) (rowsy : I32) (v : I32)] : I32
  (if (< v 0)
    0
    (tset field (if (= rowsy 1) (rows-of v) v))))

(defn margin-side [(page : String @ Region) (vs : I32) (ve : I32) (field : I32)] : I32
  (side-set field 0 (if (= (word-eq page vs ve "auto") 1) 100000 (parse-len page vs ve))))

;; border: [width] [style] [color]; `none` / `0` removes it
(defn set-border [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (let [n (parse-lens page vs ve)
        w (if (> n 0) (slot-get 604) 1)
        c (first-color page vs ve)
        none (has-tok page vs ve "none")]
    (do (tset 8 (if (= none 1) 0 w))
        (tset 9 (if (>= c 0) c 8421504))
        0)))

;; text-decoration: underline | line-through (none leaves what the element inherited)
(defn set-deco [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (cond
    ((= (has-tok page vs ve "underline") 1) (deco-mark 20))
    ((= (has-tok page vs ve "line-through") 1) (deco-mark 21))
    ((= (has-tok page vs ve "none") 1) (deco-mark 22))
    (true 0)))

;; ---- CSS3 properties that have a representation here ----
(defn set-size-kw [(page : String @ Region) (a : I32) (b : I32)] : I32
  (cond
    ((= (word-eq page a b "xx-small") 1) (tset 3 1))
    ((= (word-eq page a b "x-small") 1) (tset 3 1))
    ((= (word-eq page a b "small") 1) (tset 3 2))
    ((= (word-eq page a b "medium") 1) (tset 3 2))
    ((= (word-eq page a b "large") 1) (tset 3 2))
    ((= (word-eq page a b "x-large") 1) (tset 3 3))
    ((= (word-eq page a b "xx-large") 1) (tset 3 4))
    ((= (word-eq page a b "larger") 1) (tset 3 (if (< (tget 3) 4) (+ (tget 3) 1) 4)))
    ((= (word-eq page a b "smaller") 1) (tset 3 (if (> (tget 3) 1) (- (tget 3) 1) 1)))
    (true 0)))

(defn font-size-set [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (let [a (skip-ws page vs ve)
        b (tok-end page a ve)
        c (string/char-at page a)]
    (if (or (digit? c) (= c 46))
      (set-size (parse-len page vs ve))
      (if (= (has-at page a ve "calc(") 1)
        (set-size (parse-len page vs ve))
        (set-size-kw page a b)))))

;; 1 when the token page[a,b) carries a unit (a letter or %)
(defn tok-unit? [(page : String @ Region) (a : I32) (b : I32)] : I32
  (loop [k a]
    (if (>= k b)
      0
      (if (or (letter? (string/char-at page k)) (= (string/char-at page k) 37)) 1 (recur (+ k 1))))))

(defn font-tok [(page : String @ Region) (a : I32) (b : I32)] : I32
  (let [c (string/char-at page a)]
    (cond
      ((= (word-eq page a b "bold") 1) (tset 4 1))
      ((= (word-eq page a b "bolder") 1) (tset 4 1))
      ((and (= (- b a) 3) (and (>= c 54) (<= c 57))) (tset 4 1))
      ((and (digit? c) (= (tok-unit? page a b) 1)) (set-size (parse-len page a b)))
      (true (set-size-kw page a b)))))

;; font: [style] [weight] size[/line-height] family
(defn font-short [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (loop [k vs]
    (let [a (skip-ws page k ve)]
      (if (>= a ve)
        0
        (let [b (tok-end page a ve)
              st (font-tok page a b)]
          (recur b))))))

(defn set-boxsizing [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (xset (slot-get 31) 8 (if (= (has-tok page vs ve "border-box") 1) 1 0)))

(defn set-textxf [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (let [d (slot-get 31)]
    (cond
      ((= (has-tok page vs ve "uppercase") 1) (xset d 7 1))
      ((= (has-tok page vs ve "lowercase") 1) (xset d 7 2))
      ((= (has-tok page vs ve "capitalize") 1) (xset d 7 3))
      ((= (has-tok page vs ve "none") 1) (xset d 7 0))
      (true 0))))

;; border-left: a bar down the left edge only
(defn set-border-left [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (let [n (parse-lens page vs ve)
        w (if (> n 0) (slot-get 604) 1)
        c (first-color page vs ve)
        none (has-tok page vs ve "none")]
    (do (tset 8 (if (= none 1) 0 w))
        (tset 9 (if (>= c 0) c 8421504))
        (tset 22 1)
        0)))

(defn set-border-color [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (let [c (first-color page vs ve)]
    (if (>= c 0) (tset 9 c) 0)))

(defn set-border-width [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (let [n (parse-lens page vs ve)]
    (if (> n 0) (tset 8 (slot-get 604)) 0)))

(defn set-border-style [(page : String @ Region) (vs : I32) (ve : I32)] : I32
  (cond
    ((= (has-tok page vs ve "none") 1) (tset 8 0))
    ((= (has-tok page vs ve "hidden") 1) (tset 8 0))
    ((= (tget 8) 0) (tset 8 1))
    (true 0)))


(defn apply-prop [(page : String @ Region) (ns : I32) (ne : I32) (vs : I32) (ve : I32)] : I32
  (cond
    ((= (word-eq page ns ne "color") 1) (set-fg (parse-color page vs ve)))
    ((= (word-eq page ns ne "background-color") 1) (set-bg (parse-color page vs ve)))
    ((= (word-eq page ns ne "background") 1) (set-bg (first-color page vs ve)))
    ((= (word-eq page ns ne "font-size") 1) (font-size-set page vs ve))
    ((= (word-eq page ns ne "font") 1) (font-short page vs ve))
    ((= (word-eq page ns ne "background-image") 1) (set-bg (first-color page vs ve)))
    ((= (word-eq page ns ne "border-left") 1) (set-border-left page vs ve))
    ((= (word-eq page ns ne "border-color") 1) (set-border-color page vs ve))
    ((= (word-eq page ns ne "border-width") 1) (set-border-width page vs ve))
    ((= (word-eq page ns ne "border-style") 1) (set-border-style page vs ve))
    ((= (word-eq page ns ne "box-sizing") 1) (set-boxsizing page vs ve))
    ((= (word-eq page ns ne "text-transform") 1) (set-textxf page vs ve))
    ((= (word-eq page ns ne "font-weight") 1) (set-weight page vs ve))
    ((= (word-eq page ns ne "display") 1) (set-display page vs ve))
    ((= (word-eq page ns ne "margin") 1) (box-lens page vs ve 12))
    ((= (word-eq page ns ne "padding") 1) (box-lens page vs ve 16))
    ((= (word-eq page ns ne "margin-top") 1) (side-set 12 1 (parse-len page vs ve)))
    ((= (word-eq page ns ne "margin-right") 1) (margin-side page vs ve 13))
    ((= (word-eq page ns ne "margin-bottom") 1) (side-set 14 1 (parse-len page vs ve)))
    ((= (word-eq page ns ne "margin-left") 1) (margin-side page vs ve 15))
    ((= (word-eq page ns ne "padding-top") 1) (side-set 16 1 (parse-len page vs ve)))
    ((= (word-eq page ns ne "padding-right") 1) (side-set 17 0 (parse-len page vs ve)))
    ((= (word-eq page ns ne "padding-bottom") 1) (side-set 18 1 (parse-len page vs ve)))
    ((= (word-eq page ns ne "padding-left") 1) (side-set 19 0 (parse-len page vs ve)))
    ((= (word-eq page ns ne "border") 1) (set-border page vs ve))
    ((= (word-eq page ns ne "text-decoration") 1) (set-deco page vs ve))
    ((= (word-eq page ns ne "flex-direction") 1) (flex-dir page vs ve))
    ((= (word-eq page ns ne "gap") 1) (set-gap page vs ve))
    ((= (word-eq page ns ne "column-gap") 1) (set-gap page vs ve))
    ((= (word-eq page ns ne "width") 1) (set-width page vs ve 0))
    ((= (word-eq page ns ne "max-width") 1) (set-width page vs ve 1))
    (true 0)))

;; ---- declarations: `name: value; ...` (CSS3 pass: !important, var(), custom properties) ----
;; index of the ';' that ends the declaration starting at i (parentheses and quotes respected), or e
(defn decl-end [(t : String @ Region) (i : I32) (e : I32)] : I32
  (loop [k i depth 0 q 0]
    (if (>= k e)
      e
      (let [c (string/char-at t k)]
        (cond
          ((> q 0) (if (= c q) (recur (+ k 1) depth 0) (recur (+ k 1) depth q)))
          ((or (= c 34) (= c 39)) (recur (+ k 1) depth c))
          ((= c 40) (recur (+ k 1) (+ depth 1) 0))
          ((= c 41) (recur (+ k 1) (if (> depth 0) (- depth 1) 0) 0))
          ((and (= c 59) (= depth 0)) k)
          (true (recur (+ k 1) depth 0)))))))

;; index of the ')' that closes a '(' already consumed (i is just past it), or e
(defn paren-close [(t : String @ Region) (i : I32) (e : I32)] : I32
  (loop [k i depth 1]
    (if (>= k e)
      e
      (let [c (string/char-at t k)]
        (cond
          ((= c 40) (recur (+ k 1) (+ depth 1)))
          ((= c 41) (if (<= depth 1) k (recur (+ k 1) (- depth 1))))
          (true (recur (+ k 1) depth)))))))

;; index of the '!' of a trailing "!important" in t[vs,ve), else -1
(defn imp-pos [(t : String @ Region) (vs : I32) (ve : I32)] : I32
  (let [e (trim-end t vs ve)]
    (if (< (- e vs) 10)
      -1
      (if (= (word-eq t (- e 9) e "important") 1)
        (let [b (trim-end t vs (- e 9))]
          (if (and (> b vs) (= (string/char-at t (- b 1)) 33)) (- b 1) -1))
        -1))))

;; custom properties (--name): one document-wide table (the :root approximation), slots 1750+4k, k < 48:
;; name hash, source (0 page / 1 css store), value start, value end; count in slot 1740
(defn var-find [(h : I32)] : I32
  (loop [k 0]
    (if (>= k (slot-get 1740))
      -1
      (if (= (slot-get (+ 1750 (* k 4))) h) k (recur (+ k 1))))))

(defn var-store [(k : I32) (h : I32) (src : I32) (vs : I32) (ve : I32)] : I32
  (let [b (+ 1750 (* k 4))]
    (do (slot-set b h) (slot-set (+ b 1) src) (slot-set (+ b 2) vs) (slot-set (+ b 3) ve) 0)))

(defn var-put [(h : I32) (src : I32) (vs : I32) (ve : I32)] : I32
  (let [f (var-find h)]
    (cond
      ((>= f 0) (var-store f h src vs ve))
      ((< (slot-get 1740) 48) (do (var-store (slot-get 1740) h src vs ve) (slot-set 1740 (+ (slot-get 1740) 1)) 0))
      (true 0))))

(defn collect-vars [(t : String @ Region) (src : I32) (ds : I32) (de : I32)] : I32
  (loop [i ds]
    (let [a (skip-ws t i de)]
      (if (>= a de)
        0
        (let [colon (find-in t 58 a de)]
          (if (< colon 0)
            0
            (let [semi (decl-end t colon de)
                  ne (trim-end t a colon)
                  vs (skip-ws t (+ colon 1) semi)
                  ve (trim-end t vs semi)
                  isv (if (and (>= (- ne a) 3) (and (= (string/char-at t a) 45) (= (string/char-at t (+ a 1)) 45))) 1 0)
                  p (if (= isv 1) (var-put (hash-range t a ne) src vs ve) 0)]
              (recur (+ semi 1)))))))))

;; index of "var(" in t[s,e), else -1
(defn find-var [(t : String @ Region) (s : I32) (e : I32)] : I32
  (loop [k s]
    (if (> (+ k 4) e)
      -1
      (if (= (has-at t k e "var(") 1) k (recur (+ k 1))))))

;; the value stored for custom property entry k, itself expanded (var() inside a value)
(defn var-value [(page : String @ Region) (k : I32) (depth : I32) (dest : Arena @ Region)] : String
  (let [b (+ 1750 (* k 4))
        src (if (= (slot-get (+ b 1)) 1) (css-buf) page)]
    (expand-vars src page (slot-get (+ b 2)) (slot-get (+ b 3)) (+ depth 1) dest)))

;; the text a var( ... ) call at t[as,ae) stands for: the custom property's value, else its fallback, else ""
(defn var-text [(t : String @ Region) (page : String @ Region) (as : I32) (ae : I32) (depth : I32)
                (dest : Arena @ Region)] : String
  (let [cm (find-in t 44 as ae)
        ne (trim-end t as (if (< cm 0) ae cm))
        k (if (< depth 4) (var-find (hash-range t (skip-ws t as ae) ne)) -1)]
    (cond
      ((>= k 0) (var-value page k depth dest))
      ((and (>= cm 0) (< depth 4))
       (expand-vars t page (skip-ws t (+ cm 1) ae) (trim-end t (+ cm 1) ae) (+ depth 1) dest))
      (true ""))))

;; t[vs,ve) with every var(--x[, fallback]) replaced
(defn expand-vars [(t : String @ Region) (page : String @ Region) (vs : I32) (ve : I32) (depth : I32)
                   (dest : Arena @ Region)] : String
  (let [k (find-var t vs ve)]
    (if (< k 0)
      (string/substring t vs ve dest)
      (let [close (paren-close t (+ k 4) ve)
            pre (string/substring t vs k dest)
            rep (var-text t page (+ k 4) close depth dest)
            after (expand-vars t page (+ close 1) ve depth dest)]
        (string/concat (string/concat pre rep dest) after dest)))))

(defn decl-var-run [(t : String @ Region) (page : String @ Region) (a : I32) (ne : I32) (vs : I32) (ve : I32)
                    (dest : Arena @ Region)] : I32
  (let [nm (string/substring t a ne dest)
        vv (expand-vars t page vs ve 0 dest)
        s (string/concat (string/concat nm ":" dest) vv dest)
        nl (string/length nm)]
    (apply-prop s 0 nl (+ nl 1) (string/length s))))

(defn decl-var [(t : String @ Region) (page : String @ Region) (a : I32) (ne : I32) (vs : I32) (ve : I32)] : I32
  (if (= (word-eq t a ne "display") 1)
    0
    (with-arena [fr :region/scratch 4096]
      (decl-var-run t page a ne vs ve &mut fr))))

(defn decl-apply [(t : String @ Region) (page : String @ Region) (a : I32) (ne : I32) (vs : I32) (ve : I32)] : I32
  (if (>= (find-var t vs ve) 0)
    (decl-var t page a ne vs ve)
    (apply-prop t a ne vs ve)))

;; name: value; name: value ... in t[ds,de); mode 0 applies the normal declarations, mode 1 only the !important ones
(defn apply-decls [(t : String @ Region) (page : String @ Region) (ds : I32) (de : I32) (mode : I32)] : I32
  (loop [i ds]
    (let [a (skip-ws t i de)]
      (if (>= a de)
        0
        (let [colon (find-in t 58 a de)]
          (if (< colon 0)
            0
            (let [semi (decl-end t colon de)
                  ne (trim-end t a colon)
                  vs (skip-ws t (+ colon 1) semi)
                  ve0 (trim-end t vs semi)
                  ip (imp-pos t vs ve0)
                  ve (if (>= ip 0) (trim-end t vs ip) ve0)
                  want (if (>= ip 0) 1 0)
                  p (if (= want mode) (decl-apply t page a ne vs ve) 0)]
              (recur (+ semi 1)))))))))


;; ---- stylesheet scanning (CSS3): <style> blocks, <link rel=stylesheet>, @import, @media -> rule table ----
;; Rule k at 2100+6k (k < 160), kept sorted by specificity (stable: source order breaks ties):
;;   +0 source (0 page / 1 css store), +1 selector start, +2 selector end, +3 declarations start, +4 end, +5 specificity.
;; Selectors are matched at apply time, right to left, against the style stack plus the ancestor table (xget):
;; tag, *, .class, #id, [attr] [attr=v] ^= $= *= ~= |=, :first-child :nth-child() :not() :is() :where() :root
;; :link :checked :disabled, and the descendant / child (>) combinators. Everything else simply never matches.
(defn comment-end [(page : String @ Region) (k : I32) (e : I32)] : I32
  (loop [m k]
    (if (>= (+ m 1) e)
      e
      (if (and (= (string/char-at page m) 42) (= (string/char-at page (+ m 1)) 47))
        (+ m 2)
        (recur (+ m 1))))))

(defn css-skip [(page : String @ Region) (i : I32) (e : I32)] : I32
  (loop [k i]
    (if (>= k e)
      e
      (let [c (string/char-at page k)]
        (cond
          ((ws? c) (recur (+ k 1)))
          ((and (= c 47) (= (string/char-at page (+ k 1)) 42)) (recur (comment-end page (+ k 2) e)))
          (true k))))))

;; index past the } that closes the { at b (nested), or e
(defn skip-block [(page : String @ Region) (b : I32) (e : I32)] : I32
  (loop [k b depth 0]
    (if (>= k e)
      e
      (let [c (string/char-at page k)]
        (cond
          ((= c 123) (recur (+ k 1) (+ depth 1)))
          ((= c 125) (if (<= depth 1) (+ k 1) (recur (+ k 1) (- depth 1))))
          (true (recur (+ k 1) depth)))))))

;; end of an identifier run
(defn id-end [(t : String @ Region) (s : I32) (e : I32)] : I32
  (loop [k s]
    (if (>= k e)
      e
      (let [c (string/char-at t k)]
        (if (or (letter? c) (or (digit? c) (or (= c 45) (= c 95))))
          (recur (+ k 1))
          k)))))

;; ancestor table: entry d at 1500+10d (d < 12): +0 id hash (-2 none), +1/+2 class value range in the page (-1 none),
;; +3 children opened so far, +4 own index among its siblings (1 based), +5 tag-name end, +6 tag end ('>'),
;; +7 text-transform (0 none 1 upper 2 lower 3 capitalize; inherited), +8 box-sizing border-box
(defn xget [(d : I32) (f : I32)] : I32
  (slot-get (+ 1500 (+ (* d 10) f))))

(defn xset [(d : I32) (f : I32) (v : I32)] : I32
  (slot-set (+ 1500 (+ (* d 10) f)) v))

;; ']' closing the '[' whose content starts at i (quotes respected), or e
(defn bracket-close [(t : String @ Region) (i : I32) (e : I32)] : I32
  (loop [k i q 0]
    (if (>= k e)
      e
      (let [c (string/char-at t k)]
        (cond
          ((> q 0) (if (= c q) (recur (+ k 1) 0) (recur (+ k 1) q)))
          ((or (= c 34) (= c 39)) (recur (+ k 1) c))
          ((= c 93) k)
          (true (recur (+ k 1) 0)))))))

;; closing quote q at/after i within e, else e
(defn quote-close [(t : String @ Region) (i : I32) (q : I32) (e : I32)] : I32
  (loop [k i]
    (if (>= k e)
      e
      (if (= (string/char-at t k) q) k (recur (+ k 1))))))

;; case-insensitive equality of t[a,b) and p[c,d)
(defn rng-ieq [(t : String @ Region) (a : I32) (b : I32) (p : String @ Region) (c : I32) (d : I32)] : I32
  (if (= (- b a) (- d c))
    (loop [k 0]
      (if (>= k (- b a))
        1
        (if (= (lc (string/char-at t (+ a k))) (lc (string/char-at p (+ c k))))
          (recur (+ k 1))
          0)))
    0))

;; exact equality
(defn rng-eq [(t : String @ Region) (a : I32) (b : I32) (p : String @ Region) (c : I32) (d : I32)] : I32
  (if (= (- b a) (- d c))
    (loop [k 0]
      (if (>= k (- b a))
        1
        (if (= (string/char-at t (+ a k)) (string/char-at p (+ c k)))
          (recur (+ k 1))
          0)))
    0))

(defn attr-name-end [(p : String @ Region) (a : I32) (te : I32)] : I32
  (loop [k a]
    (if (>= k te)
      te
      (let [c (string/char-at p k)]
        (if (or (ws? c) (or (= c 61) (or (= c 47) (= c 62)))) k (recur (+ k 1)))))))

(defn unq-end [(p : String @ Region) (a : I32) (te : I32)] : I32
  (loop [k a]
    (if (>= k te)
      te
      (let [c (string/char-at p k)]
        (if (or (ws? c) (= c 62)) k (recur (+ k 1)))))))

;; the attribute t[na,nb) among page[k0,te): 1 when present (value range -> slots 1648/1649), else 0
(defn attr-scan [(t : String @ Region) (na : I32) (nb : I32) (p : String @ Region) (k0 : I32) (te : I32)] : I32
  (loop [k k0]
    (let [a (skip-ws p k te)]
      (if (or (>= a te) (or (= (string/char-at p a) 47) (= (string/char-at p a) 62)))
        0
        (let [ae (attr-name-end p a te)
              q (skip-ws p ae te)
              hasv (if (and (< q te) (= (string/char-at p q) 61)) 1 0)
              hit (rng-ieq t na nb p a ae)
              v0 (if (= hasv 1) (skip-ws p (+ q 1) te) ae)
              qc (if (= hasv 1) (string/char-at p v0) 0)
              quoted (if (or (= qc 34) (= qc 39)) 1 0)
              vs (if (= quoted 1) (+ v0 1) v0)
              ve (if (= hasv 0) ae (if (= quoted 1) (quote-close p vs qc te) (unq-end p vs te)))
              nxt (if (= quoted 1) (+ ve 1) (if (> ve a) ve (+ a 1)))]
          (if (= hit 1)
            (do (slot-set 1648 vs) (slot-set 1649 ve) 1)
            (recur nxt)))))))

(defn attr-lookup [(t : String @ Region) (na : I32) (nb : I32) (p : String @ Region) (d : I32)] : I32
  (if (< (xget d 6) 0)
    0
    (attr-scan t na nb p (xget d 5) (xget d 6))))

(defn s-starts [(t : String @ Region) (xs : I32) (xe : I32) (p : String @ Region) (ps : I32) (pe : I32)] : I32
  (if (<= (- xe xs) (- pe ps))
    (rng-eq t xs xe p ps (+ ps (- xe xs)))
    0))

(defn s-ends [(t : String @ Region) (xs : I32) (xe : I32) (p : String @ Region) (ps : I32) (pe : I32)] : I32
  (if (<= (- xe xs) (- pe ps))
    (rng-eq t xs xe p (- pe (- xe xs)) pe)
    0))

(defn s-contains [(t : String @ Region) (xs : I32) (xe : I32) (p : String @ Region) (ps : I32) (pe : I32)] : I32
  (if (> (- xe xs) (- pe ps))
    0
    (loop [k ps]
      (if (> (+ k (- xe xs)) pe)
        0
        (if (= (rng-eq t xs xe p k (+ k (- xe xs))) 1) 1 (recur (+ k 1)))))))

;; a whitespace-separated word of p[ps,pe) equals t[xs,xe)
(defn s-word [(t : String @ Region) (xs : I32) (xe : I32) (p : String @ Region) (ps : I32) (pe : I32)] : I32
  (loop [k ps]
    (let [a (skip-ws p k pe)]
      (if (>= a pe)
        0
        (let [b (tok-end p a pe)]
          (if (= (rng-eq t xs xe p a b) 1) 1 (recur b)))))))

(defn s-dash [(t : String @ Region) (xs : I32) (xe : I32) (p : String @ Region) (ps : I32) (pe : I32)] : I32
  (if (= (rng-eq t xs xe p ps pe) 1)
    1
    (if (and (> (- pe ps) (- xe xs)) (= (s-starts t xs xe p ps pe) 1))
      (if (= (string/char-at p (+ ps (- xe xs))) 45) 1 0)
      0)))

(defn attr-op [(t : String @ Region) (op : I32) (xs : I32) (xe : I32) (p : String @ Region)] : I32
  (let [ps (slot-get 1648)
        pe (slot-get 1649)]
    (cond
      ((= (- xe xs) 0) 0)
      ((= op 61) (rng-eq t xs xe p ps pe))
      ((= op 94) (s-starts t xs xe p ps pe))
      ((= op 36) (s-ends t xs xe p ps pe))
      ((= op 42) (s-contains t xs xe p ps pe))
      ((= op 126) (s-word t xs xe p ps pe))
      ((= op 124) (s-dash t xs xe p ps pe))
      (true 0))))

;; first of = ~ | ^ $ * in t[a,q), else q
(defn attr-sel-end [(t : String @ Region) (a : I32) (q : I32)] : I32
  (loop [k a]
    (if (>= k q)
      q
      (let [c (string/char-at t k)]
        (if (or (= c 61) (or (= c 126) (or (= c 124) (or (= c 94) (or (= c 36) (= c 42))))))
          k
          (recur (+ k 1)))))))

(defn attr-cmp [(t : String @ Region) (p : String @ Region) (ne : I32) (q : I32)] : I32
  (let [c (string/char-at t ne)
        v0 (skip-ws t (if (= c 61) (+ ne 1) (+ ne 2)) q)
        qc (string/char-at t v0)
        quoted (if (or (= qc 34) (= qc 39)) 1 0)
        xs (if (= quoted 1) (+ v0 1) v0)
        xe (if (= quoted 1) (quote-close t xs qc q) (trim-end t xs q))]
    (attr-op t c xs xe p)))

;; [name], [name=v], [name^=v] ... with t[a,q) the text between the brackets
(defn attr-match [(t : String @ Region) (p : String @ Region) (a : I32) (q : I32) (d : I32)] : I32
  (let [ne (attr-sel-end t a q)
        nm (trim-end t a ne)
        found (attr-lookup t a nm p d)]
    (cond
      ((= found 0) 0)
      ((>= ne q) 1)
      (true (attr-cmp t p ne q)))))

;; an+b / odd / even / N against a 1-based index
(defn nth-num [(t : String @ Region) (s : I32) (e : I32)] : I32
  (if (>= s e)
    0
    (let [neg (if (= (string/char-at t s) 45) 1 0)
          st (if (or (= (string/char-at t s) 45) (= (string/char-at t s) 43)) (+ s 1) s)
          v (scan-int t st e)]
      (if (= neg 1) (- 0 v) v))))

(defn nth-ab [(t : String @ Region) (s : I32) (e : I32) (n : I32) (idx : I32)] : I32
  (let [a0 (skip-ws t s n)
        ae (trim-end t a0 n)
        a (if (>= a0 ae) 1 (if (and (= (- ae a0) 1) (= (string/char-at t a0) 45)) -1 (if (and (= (- ae a0) 1) (= (string/char-at t a0) 43)) 1 (nth-num t a0 ae))))
        bs (skip-ws t (+ n 1) e)
        b (nth-num t bs (trim-end t bs e))
        diff (- idx b)]
    (cond
      ((= a 0) (if (= idx b) 1 0))
      ((> a 0) (if (and (>= diff 0) (= (mod diff a) 0)) 1 0))
      (true (if (and (<= diff 0) (= (mod (- 0 diff) (- 0 a)) 0)) 1 0)))))

(defn nth-test [(t : String @ Region) (s0 : I32) (e0 : I32) (idx : I32)] : I32
  (let [s (skip-ws t s0 e0)
        e (trim-end t s e0)
        n (find-in t 110 s e)]
    (cond
      ((>= s e) 0)
      ((= (word-eq t s e "odd") 1) (if (= (mod idx 2) 1) 1 0))
      ((= (word-eq t s e "even") 1) (if (= (mod idx 2) 0) 1 0))
      ((< n 0) (if (= (nth-num t s e) idx) 1 0))
      (true (nth-ab t s e n idx)))))

(defn cls-hit [(t : String @ Region) (p : String @ Region) (s : I32) (e : I32) (d : I32)] : I32
  (if (or (>= s e) (< (xget d 1) 0))
    0
    (class-has? p (xget d 1) (xget d 2) (hash-range t s e))))

(defn comma-top [(t : String @ Region) (i : I32) (e : I32)] : I32
  (loop [k i depth 0]
    (if (>= k e)
      e
      (let [c (string/char-at t k)]
        (cond
          ((or (= c 40) (= c 91)) (recur (+ k 1) (+ depth 1)))
          ((or (= c 41) (= c 93)) (recur (+ k 1) (if (> depth 0) (- depth 1) 0)))
          ((and (= c 44) (= depth 0)) k)
          (true (recur (+ k 1) depth)))))))

;; any comma-separated compound selector of t[s,e) matches the element at depth d
(defn list-any [(t : String @ Region) (p : String @ Region) (s : I32) (e : I32) (d : I32)] : I32
  (loop [k s]
    (if (>= k e)
      0
      (let [c (comma-top t k e)
            a (skip-ws t k c)
            b (trim-end t a c)]
        (if (and (< a b) (= (cmp-step t p a b d) 1))
          1
          (recur (+ c 1)))))))

(defn pseudo-test [(t : String @ Region) (p : String @ Region) (ps : I32) (pe : I32) (as : I32) (ae : I32) (d : I32)] : I32
  (cond
    ((= (word-eq t ps pe "first-child") 1) (if (= (xget d 4) 1) 1 0))
    ((= (word-eq t ps pe "nth-child") 1) (nth-test t as ae (xget d 4)))
    ((= (word-eq t ps pe "root") 1) (if (= d 1) 1 0))
    ((= (word-eq t ps pe "not") 1) (- 1 (list-any t p as ae d)))
    ((= (word-eq t ps pe "is") 1) (list-any t p as ae d))
    ((= (word-eq t ps pe "where") 1) (list-any t p as ae d))
    ((= (word-eq t ps pe "link") 1) (attr-lookup "href" 0 4 p d))
    ((= (word-eq t ps pe "any-link") 1) (attr-lookup "href" 0 4 p d))
    ((= (word-eq t ps pe "checked") 1) (attr-lookup "checked" 0 7 p d))
    ((= (word-eq t ps pe "disabled") 1) (attr-lookup "disabled" 0 8 p d))
    ((= (word-eq t ps pe "enabled") 1) (- 1 (attr-lookup "disabled" 0 8 p d)))
    (true 0)))

(defn cmp-class [(t : String @ Region) (p : String @ Region) (k : I32) (b : I32) (d : I32)] : I32
  (let [ne (id-end t (+ k 1) b)]
    (if (= (cls-hit t p (+ k 1) ne d) 1) (cmp-step t p ne b d) 0)))

(defn cmp-id [(t : String @ Region) (p : String @ Region) (k : I32) (b : I32) (d : I32)] : I32
  (let [ne (id-end t (+ k 1) b)]
    (if (and (> ne (+ k 1)) (= (hash-range t (+ k 1) ne) (xget d 0))) (cmp-step t p ne b d) 0)))

(defn cmp-tag [(t : String @ Region) (p : String @ Region) (k : I32) (b : I32) (d : I32)] : I32
  (let [ne (id-end t k b)]
    (if (and (> ne k) (= (hash-range t k ne) (eget d 0))) (cmp-step t p ne b d) 0)))

(defn cmp-attr [(t : String @ Region) (p : String @ Region) (k : I32) (b : I32) (d : I32)] : I32
  (let [q (bracket-close t (+ k 1) b)]
    (if (and (< q b) (= (attr-match t p (+ k 1) q d) 1)) (cmp-step t p (+ q 1) b d) 0)))

(defn cmp-pseudo-go [(t : String @ Region) (p : String @ Region) (k : I32) (ne : I32) (b : I32) (d : I32)] : I32
  (if (and (< ne b) (= (string/char-at t ne) 40))
    (let [q (paren-close t (+ ne 1) b)]
      (if (= (pseudo-test t p (+ k 1) ne (+ ne 1) q d) 1) (cmp-step t p (+ q 1) b d) 0))
    (if (= (pseudo-test t p (+ k 1) ne ne ne d) 1) (cmp-step t p ne b d) 0)))

(defn cmp-pseudo [(t : String @ Region) (p : String @ Region) (k : I32) (b : I32) (d : I32)] : I32
  (if (= (string/char-at t (+ k 1)) 58)
    0
    (cmp-pseudo-go t p k (id-end t (+ k 1) b) b d)))

;; the compound selector t[k,b) against the element at depth d, from position k on
(defn cmp-step [(t : String @ Region) (p : String @ Region) (k : I32) (b : I32) (d : I32)] : I32
  (if (>= k b)
    1
    (let [c (string/char-at t k)]
      (cond
        ((= c 42) (cmp-step t p (+ k 1) b d))
        ((= c 46) (cmp-class t p k b d))
        ((= c 35) (cmp-id t p k b d))
        ((= c 91) (cmp-attr t p k b d))
        ((= c 58) (cmp-pseudo t p k b d))
        (true (cmp-tag t p k b d))))))

;; start of the last compound selector of t[s,e): scanning back to whitespace / '>' / '+' / '~' outside [] and ()
(defn compound-start [(t : String @ Region) (s : I32) (e : I32)] : I32
  (loop [k e depth 0]
    (if (<= k s)
      s
      (let [c (string/char-at t (- k 1))]
        (cond
          ((or (= c 93) (= c 41)) (recur (- k 1) (+ depth 1)))
          ((or (= c 91) (= c 40)) (recur (- k 1) (if (> depth 0) (- depth 1) 0)))
          ((and (= depth 0) (or (ws? c) (or (= c 62) (or (= c 43) (= c 126))))) k)
          (true (recur (- k 1) depth)))))))

(defn sel-match [(t : String @ Region) (p : String @ Region) (s : I32) (e : I32) (d : I32)] : I32
  (let [e2 (trim-end t s e)]
    (if (or (>= s e2) (< d 1))
      0
      (let [cs (compound-start t s e2)]
        (if (= (cmp-step t p cs e2 d) 0)
          0
          (sel-left t p s cs d))))))

;; the selector part before the compound that just matched: descendant / child combinators
(defn sel-left [(t : String @ Region) (p : String @ Region) (s : I32) (cs : I32) (d : I32)] : I32
  (let [q (trim-end t s cs)]
    (if (<= q s)
      1
      (let [c (string/char-at t (- q 1))]
        (cond
          ((= c 62) (sel-match t p s (- q 1) (- d 1)))
          ((or (= c 43) (= c 126)) 0)
          (true (sel-any-ancestor t p s q (- d 1))))))))

(defn sel-any-ancestor [(t : String @ Region) (p : String @ Region) (s : I32) (q : I32) (a : I32)] : I32
  (loop [k a]
    (if (< k 1)
      0
      (if (= (sel-match t p s q k) 1) 1 (recur (- k 1))))))

;; specificity: ids * 10000 + (classes, attributes, pseudo-classes) * 100 + tags
(defn sel-spec [(t : String @ Region) (s : I32) (e : I32)] : I32
  (loop [k s sp 0 prev 32]
    (if (>= k e)
      sp
      (let [c (string/char-at t k)]
        (cond
          ((= c 35) (recur (+ k 1) (+ sp 10000) c))
          ((= c 46) (recur (+ k 1) (+ sp 100) c))
          ((= c 91) (recur (+ (bracket-close t (+ k 1) e) 1) (+ sp 100) 93))
          ((= c 58) (if (= (string/char-at t (+ k 1)) 58)
                      (recur (+ k 2) (+ sp 1) 58)
                      (recur (+ k 1) (+ sp 100) 58)))
          ((and (letter? c) (or (ws? prev) (= prev 62))) (recur (id-end t k e) (+ sp 1) 97))
          (true (recur (+ k 1) sp c)))))))

;; a selector this engine can ever match: no sibling combinators outside brackets, no pseudo-elements
(defn sel-ok? [(t : String @ Region) (s : I32) (e : I32)] : I32
  (loop [k s depth 0]
    (if (>= k e)
      1
      (let [c (string/char-at t k)]
        (cond
          ((or (= c 91) (= c 40)) (recur (+ k 1) (+ depth 1)))
          ((or (= c 93) (= c 41)) (recur (+ k 1) (if (> depth 0) (- depth 1) 0)))
          ((and (= depth 0) (or (= c 43) (= c 126))) 0)
          ((and (= c 58) (= (string/char-at t (+ k 1)) 58)) 0)
          (true (recur (+ k 1) depth)))))))

(defn rule-pos [(sp : I32) (n : I32)] : I32
  (loop [k 0]
    (if (>= k n)
      n
      (if (> (slot-get (+ 2105 (* k 6))) sp) k (recur (+ k 1))))))

(defn rule-shift [(pos : I32) (n : I32)] : I32
  (loop [k (- n 1)]
    (if (< k pos)
      0
      (let [a (+ 2100 (* k 6))
            b (+ a 6)]
        (do (slot-set b (slot-get a)) (slot-set (+ b 1) (slot-get (+ a 1))) (slot-set (+ b 2) (slot-get (+ a 2)))
            (slot-set (+ b 3) (slot-get (+ a 3))) (slot-set (+ b 4) (slot-get (+ a 4))) (slot-set (+ b 5) (slot-get (+ a 5)))
            (recur (- k 1)))))))

(defn add-rule [(t : String @ Region) (src : I32) (s : I32) (e : I32) (ds : I32) (de : I32)] : I32
  (let [n (slot-get 30)]
    (if (or (>= s e) (or (>= n 160) (= (sel-ok? t s e) 0)))
      0
      (let [sp (sel-spec t s e)
            pos (rule-pos sp n)
            sh (rule-shift pos n)
            b (+ 2100 (* pos 6))]
        (do (slot-set b src) (slot-set (+ b 1) s) (slot-set (+ b 2) e) (slot-set (+ b 3) ds) (slot-set (+ b 4) de)
            (slot-set (+ b 5) sp)
            (slot-set 30 (+ n 1))
            0)))))

;; a comma-separated selector list t[a,b) sharing the declaration block t[ds,de)
(defn add-selectors [(t : String @ Region) (src : I32) (a : I32) (b : I32) (ds : I32) (de : I32)] : I32
  (loop [k a]
    (if (>= k b)
      0
      (let [c (comma-top t k b)
            s (skip-ws t k c)
            e (trim-end t s c)
            r (if (< s e) (add-rule t src s e ds de) 0)]
        (recur (+ c 1))))))

;; ---- media queries: viewport width/height are slots 1646/1647 ----
(defn mq-len [(t : String @ Region) (s : I32) (e : I32)] : I32
  (parse-len t s e))

(defn mq-cmp [(have : I32) (op : I32) (want : I32)] : I32
  (cond
    ((< want 0) 0)
    ((= op 1) (if (>= have want) 1 0))
    ((= op 2) (if (<= have want) 1 0))
    ((= op 3) (if (> have want) 1 0))
    ((= op 4) (if (< have want) 1 0))
    (true (if (= have want) 1 0))))

;; (feature: value) with t[s,e) the text between the parentheses
(defn mq-feature [(t : String @ Region) (s : I32) (e : I32) (colon : I32)] : I32
  (let [ne (trim-end t s colon)
        vs (skip-ws t (+ colon 1) e)
        ve (trim-end t vs e)]
    (cond
      ((= (word-eq t s ne "min-width") 1) (mq-cmp (slot-get 1646) 1 (mq-len t vs ve)))
      ((= (word-eq t s ne "max-width") 1) (mq-cmp (slot-get 1646) 2 (mq-len t vs ve)))
      ((= (word-eq t s ne "min-height") 1) (mq-cmp (slot-get 1647) 1 (mq-len t vs ve)))
      ((= (word-eq t s ne "max-height") 1) (mq-cmp (slot-get 1647) 2 (mq-len t vs ve)))
      ((= (word-eq t s ne "width") 1) (mq-cmp (slot-get 1646) 0 (mq-len t vs ve)))
      ((= (word-eq t s ne "height") 1) (mq-cmp (slot-get 1647) 0 (mq-len t vs ve)))
      ((= (word-eq t s ne "orientation") 1) (if (= (word-eq t vs ve "landscape") 1) 1 0))
      ((= (word-eq t s ne "prefers-color-scheme") 1) (if (= (word-eq t vs ve "dark") 1) 1 0))
      ((= (word-eq t s ne "hover") 1) (if (= (word-eq t vs ve "hover") 1) 1 0))
      ((= (word-eq t s ne "any-hover") 1) (if (= (word-eq t vs ve "hover") 1) 1 0))
      ((= (word-eq t s ne "pointer") 1) (if (= (word-eq t vs ve "fine") 1) 1 0))
      ((= (word-eq t s ne "prefers-reduced-motion") 1) (if (= (word-eq t vs ve "reduce") 1) 1 0))
      ((= (word-eq t s ne "color") 1) 1)
      (true 0))))

;; range syntax: (width >= 600px) (height < 400px)
(defn mq-range [(t : String @ Region) (s : I32) (e : I32)] : I32
  (let [g (find-in t 62 s e)
        l (find-in t 60 s e)
        at (if (>= g 0) g l)]
    (if (< at 0)
      0
      (let [ge (if (>= g 0) 1 0)
            eq (if (= (string/char-at t (+ at 1)) 61) 1 0)
            ne (trim-end t s at)
            vs (skip-ws t (+ at (+ 1 eq)) e)
            ve (trim-end t vs e)
            op (if (= ge 1) (if (= eq 1) 1 3) (if (= eq 1) 2 4))]
        (cond
          ((= (word-eq t s ne "width") 1) (mq-cmp (slot-get 1646) op (mq-len t vs ve)))
          ((= (word-eq t s ne "height") 1) (mq-cmp (slot-get 1647) op (mq-len t vs ve)))
          (true 0))))))

(defn mq-cond [(t : String @ Region) (s : I32) (e : I32)] : I32
  (let [colon (find-in t 58 s e)]
    (if (>= colon 0) (mq-feature t (skip-ws t s e) e colon) (mq-range t s e))))

(defn mq-word-end [(t : String @ Region) (a : I32) (e : I32)] : I32
  (loop [k a]
    (if (>= k e)
      e
      (let [c (string/char-at t k)]
        (if (or (ws? c) (= c 40)) k (recur (+ k 1)))))))

(defn mq-type-ok [(t : String @ Region) (a : I32) (b : I32)] : I32
  (cond
    ((= (word-eq t a b "and") 1) 1)
    ((= (word-eq t a b "only") 1) 1)
    ((= (word-eq t a b "all") 1) 1)
    ((= (word-eq t a b "screen") 1) 1)
    (true 0)))

;; every part of one media query (a type or a parenthesised feature) holds
(defn mq-and [(t : String @ Region) (s : I32) (e : I32)] : I32
  (loop [k s]
    (let [a (skip-ws t k e)]
      (if (>= a e)
        1
        (if (= (string/char-at t a) 40)
          (let [q (paren-close t (+ a 1) e)]
            (if (= (mq-cond t (+ a 1) q) 1) (recur (+ q 1)) 0))
          (let [b (mq-word-end t a e)]
            (if (= (mq-type-ok t a b) 1) (recur (if (> b a) b (+ a 1))) 0)))))))

(defn mq-eval [(t : String @ Region) (s : I32) (e : I32)] : I32
  (let [a (skip-ws t s e)
        neg (if (= (has-at t a e "not ") 1) 1 0)
        r (mq-and t (if (= neg 1) (+ a 4) a) e)]
    (if (= neg 1) (- 1 r) r)))

;; a media query list t[s,e): any comma-separated query holding; an empty list holds
(defn media-match [(t : String @ Region) (s : I32) (e : I32)] : I32
  (if (>= (skip-ws t s e) e)
    1
    (loop [k s]
      (if (>= k e)
        0
        (let [c (comma-top t k e)]
          (if (= (mq-eval t k c) 1) 1 (recur (+ c 1))))))))

;; ---- external sheets (<link rel=stylesheet>, @import): table at 3100+10k, k < 16, count in slot 1640 ----
;; +0 key (tag index / import position), +1 state (0 queued, 1 fetching, 2 loaded, 3 failed), +2/+3 text range in the
;; css store, +4 parent sheet (-1 the page), +5 kind (0 link, 1 import), +6 url text source (0 page / 1 css store),
;; +7/+8 url range, +9 hop count
(defn sh-get [(k : I32) (f : I32)] : I32
  (slot-get (+ 3100 (+ (* k 10) f))))

(defn sh-set [(k : I32) (f : I32) (v : I32)] : I32
  (slot-set (+ 3100 (+ (* k 10) f)) v))

(defn sh-find [(key : I32) (kind : I32)] : I32
  (loop [k 0]
    (if (>= k (slot-get 1640))
      -1
      (if (and (= (sh-get k 0) key) (= (sh-get k 5) kind)) k (recur (+ k 1))))))

(defn sh-new [(key : I32) (kind : I32) (parent : I32) (src : I32) (us : I32) (ue : I32)] : I32
  (let [k (slot-get 1640)]
    (if (or (>= k 16) (not (= (slot-get 6) 1)))
      -1
      (do (sh-set k 0 key) (sh-set k 1 0) (sh-set k 2 0) (sh-set k 3 0) (sh-set k 4 parent) (sh-set k 5 kind)
          (sh-set k 6 src) (sh-set k 7 us) (sh-set k 8 ue) (sh-set k 9 0)
          (slot-set 1640 (+ k 1))
          k))))

(defn sh-entry [(key : I32) (kind : I32) (parent : I32) (src : I32) (us : I32) (ue : I32)] : I32
  (let [f (sh-find key kind)]
    (if (>= f 0) f (sh-new key kind parent src us ue))))

;; the loaded sheet whose css-store text contains pos, else -1
(defn sh-owner [(pos : I32)] : I32
  (loop [k 0]
    (if (>= k (slot-get 1640))
      -1
      (if (and (= (sh-get k 1) 2) (and (>= pos (sh-get k 2)) (< pos (sh-get k 3)))) k (recur (+ k 1))))))

;; parse the text of loaded sheet k now (its place in the document order)
(defn sheet-apply [(k : I32) (depth : I32)] : I32
  (if (and (>= k 0) (and (= (sh-get k 1) 2) (< depth 3)))
    (parse-css (css-buf) 1 (sh-get k 2) (sh-get k 3) (+ depth 1))
    0))

;; @import <url> [media]: t[ps,pe) is the prelude after the at-keyword
(defn import-paren-end [(t : String @ Region) (s : I32) (e : I32)] : I32
  (let [q (find-in t 41 s e)]
    (if (< q 0) e (trim-end t s q))))

(defn import-url-end [(t : String @ Region) (s : I32) (e : I32)] : I32
  (let [c (string/char-at t (- s 1))]
    (if (or (= c 34) (= c 39))
      (quote-close t s c e)
      (import-paren-end t s e))))

(defn import-url-start [(t : String @ Region) (s : I32) (e : I32)] : I32
  (let [k (skip-ws t s e)]
    (if (= (has-at t k e "url(") 1)
      (let [a (skip-ws t (+ k 4) e)
            c (string/char-at t a)]
        (if (or (= c 34) (= c 39)) (+ a 1) a))
      (if (or (= (string/char-at t k) 34) (= (string/char-at t k) 39)) (+ k 1) -1))))

(defn import-rest [(t : String @ Region) (ue : I32) (e : I32)] : I32
  (let [c (string/char-at t ue)
        a (if (or (= c 34) (= c 39)) (+ ue 1) ue)
        b (if (= (string/char-at t a) 41) (+ a 1) a)]
    b))

(defn sheet-import [(t : String @ Region) (src : I32) (ps : I32) (pe : I32) (depth : I32)] : I32
  (let [us (import-url-start t ps pe)]
    (if (< us 0)
      0
      (let [ue (import-url-end t us pe)
            rs (import-rest t ue pe)
            mm (media-match t rs pe)
            par (if (= src 1) (sh-owner ps) -1)
