;; table columns: widths are measured from the source between <table> and </table>, then every cell starts at
;; its column's x offset (a header row gets a rule under it)
(defn tb-store [(col : I32) (n : I32) (pend : I32)] : I32
  (if (and (= pend 1) (and (< col 8) (> n (slot-get (+ 650 col)))))
    (slot-set (+ 650 col) n)
    0))

(defn tb-reset [] : I32
  (loop [k 0]
    (if (>= k 8)
      0
      (let [x (slot-set (+ 650 k) 0)] (recur (+ k 1))))))

(defn tb-offsets [] : I32
  (loop [k 0 acc 0]
    (if (>= k 8)
      (slot-set 645 acc)
      (let [w (slot-get (+ 650 k))
            x (slot-set (+ 650 k) acc)]
        (recur (+ k 1) (+ acc (if (> w 0) (* (+ w 2) (* 6 (tget 3))) 0)))))))

(defn tb-scan [(page : String @ Region) (from : I32) (lim : I32)] : I32
  (loop [k from col 0 n 0 pend 0]
    (if (>= k lim)
      0
      (let [c (string/char-at page k)]
        (if (= c 60)
          (let [gt (find-in page 62 k lim)]
            (if (< gt 0)
              0
              (let [cl (if (= (string/char-at page (+ k 1)) 47) 1 0)
                    ns (+ k (+ 1 cl))
                    ne (name-end page ns gt)
                    istd (if (or (= (word-eq page ns ne "td") 1) (= (word-eq page ns ne "th") 1)) 1 0)
                    istr (word-eq page ns ne "tr")
                    istb (word-eq page ns ne "table")
                    st (if (or (= istd 1) (or (= istr 1) (= istb 1))) (tb-store col n pend) 0)]
                (cond
                  ((and (= cl 1) (= istb 1)) 0)
                  ((and (= istd 1) (= cl 0)) (recur (+ gt 1) (+ col pend) 0 1))
                  ((= istd 1) (recur (+ gt 1) (+ col pend) 0 0))
                  ((= istr 1) (recur (+ gt 1) 0 0 0))
                  (true (recur (+ gt 1) col n pend))))))
          (cond
            ((or (= c 10) (or (= c 13) (= c 9))) (recur (+ k 1) col n pend))
            ((= c 38)
             (let [sm (find-in page 59 k (if (< (+ k 9) lim) (+ k 9) lim))]
               (recur (if (< sm 0) (+ k 1) (+ sm 1)) col (+ n pend) pend)))
            (true (recur (+ k 1) col (+ n pend) pend))))))))

(defn table-open [(page : String @ Region) (ns : I32) (ne : I32) (te : I32)] : I32
  (let [r (tb-reset)
        sc (tb-scan page (+ te 1) (slot-get 617))
        of (tb-offsets)]
    (push-styled page ns ne te)))

