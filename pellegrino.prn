;; ---- v1.8: <q>, <details>/<summary> toggle, table columns, <select> <textarea> <progress> <meter> ----
;; Slots: 633 stack index of a collapsed <details> (0 none), 634 summary un-hid it, 635/636/637 newline-after-hidden
;; bookkeeping, 631/632 underline / line-through depth, 638 toggle count, 640 cell index in the row, 641 row has <th>,
;; 642-644 open <summary> (col, row, details tag index*2 + shown), 645 table width px, 650-657 column x offsets,
;; 660+2k details tag index / 661+2k flipped (k < 16), 680+d details tag index*2 + shown at stack depth d.
(defn q-open [(page : String @ Region) (ns : I32) (ne : I32) (te : I32)] : I32
  (do (push-styled page ns ne te) (put-lit 34 0 0)))

(defn q-close [(page : String @ Region) (ns : I32) (ne : I32)] : I32
  (if (> (find-open (hash-range page ns ne)) 0)
    (do (put-lit 34 0 0) (close-generic page ns ne))
    0))

;; 1 if the bare attribute `lit` (open, selected, ...) is in the tag page[ne,te)
(defn bool-attr? [(page : String @ Region) (ne : I32) (te : I32) (lit : String @ Region)] : I32
  (let [n (string/length lit)]
    (loop [i ne]
      (if (> (+ i n) te)
        0
        (if (and (ws? (string/char-at page (- i 1)))
                 (and (= (match-at page i lit) 1) (not (letter? (string/char-at page (+ i n))))))
          1
          (recur (+ i 1)))))))

(defn tg-find [(pos : I32)] : I32
  (loop [k 0]
    (if (>= k (slot-get 638))
      -1
      (if (= (slot-get (+ 660 (* k 2))) pos) k (recur (+ k 1))))))

(defn tg-add [(pos : I32)] : I32
